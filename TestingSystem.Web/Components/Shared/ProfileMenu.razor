@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceScopeFactory ScopeFactory

@if (CurrentUser is not null)
{
    <button class="user-summary" type="button" @onclick="OpenProfile" aria-label="Open profile">
        <span class="user-avatar">@GetInitial(DisplayName)</span>
        <span>
            <strong>@DisplayName</strong>
            <small>@RoleName · Edit profile</small>
        </span>
    </button>
}

@if (IsOpen && CurrentUser is not null)
{
    <div class="profile-overlay" role="presentation">
        <section class="profile-dialog" role="dialog" aria-modal="true" aria-labelledby="profile-title">
            <div class="profile-dialog-header">
                <div>
                    <p class="section-label">Account settings</p>
                    <h2 id="profile-title">Edit profile</h2>
                </div>
                <button class="profile-close" type="button" @onclick="CloseProfile" aria-label="Close profile">×</button>
            </div>

            <form @onsubmit="SaveProfile" @onsubmit:preventDefault>
                <div class="profile-identity">
                    <span class="profile-large-avatar">@GetInitial(EditDisplayName)</span>
                    <div>
                        <strong>@DisplayName</strong>
                        <small>Only name and phone number can be changed.</small>
                    </div>
                </div>

                <div class="profile-form-grid">
                    <label class="profile-field">
                        <span>Name <b>Editable</b></span>
                        <input type="text" maxlength="160" required @bind="EditDisplayName" />
                    </label>

                    <label class="profile-field">
                        <span>Phone number <b>Editable</b></span>
                        <input type="tel" maxlength="32" placeholder="+60 12-345 6789" @bind="EditPhoneNumber" />
                    </label>

                    <label class="profile-field">
                        <span>Role <i>Permanent</i></span>
                        <input type="text" value="@RoleName" readonly />
                    </label>

                    <label class="profile-field">
                        <span>Email <i>Permanent</i></span>
                        <input type="email" value="@EmailAddress" readonly />
                    </label>

                    <label class="profile-field">
                        <span>Sign-in method <i>Managed</i></span>
                        <input type="text" value="Microsoft Entra ID" readonly />
                    </label>

                    <label class="profile-field">
                        <span>Account status <i>Managed</i></span>
                        <input type="text" value="@CurrentUser.AccessStatus" readonly />
                    </label>
                </div>

                @if (!string.IsNullOrEmpty(StatusMessage))
                {
                    <p class="profile-message @(SaveSucceeded ? "success" : "error")" role="status">@StatusMessage</p>
                }

                <div class="profile-actions">
                    <button class="profile-cancel" type="button" @onclick="CloseProfile">Cancel</button>
                    <button class="primary-action" type="submit" disabled="@IsSaving">
                        @(IsSaving ? "Saving..." : "Save changes") <span>→</span>
                    </button>
                </div>
            </form>
        </section>
    </div>
}

@code {
    private ApplicationUser? CurrentUser { get; set; }
    private string RoleName { get; set; } = "User";
    private string EditDisplayName { get; set; } = string.Empty;
    private string EditPhoneNumber { get; set; } = string.Empty;
    private string StatusMessage { get; set; } = string.Empty;
    private bool IsOpen { get; set; }
    private bool IsSaving { get; set; }
    private bool SaveSucceeded { get; set; }

    private string DisplayName => string.IsNullOrWhiteSpace(CurrentUser?.DisplayName)
        ? CurrentUser?.UserName ?? "User"
        : CurrentUser.DisplayName;

    private string EmailAddress => string.IsNullOrWhiteSpace(CurrentUser?.Email)
        ? "Not assigned"
        : CurrentUser.Email;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrWhiteSpace(userId)) return;

        await using var scope = ScopeFactory.CreateAsyncScope();
        var userManager = scope.ServiceProvider.GetRequiredService<Microsoft.AspNetCore.Identity.UserManager<ApplicationUser>>();
        CurrentUser = await userManager.FindByIdAsync(userId);

        if (CurrentUser is not null)
        {
            var roles = await userManager.GetRolesAsync(CurrentUser);
            RoleName = roles.FirstOrDefault() ?? "User";
            ResetEditableFields();
        }
    }

    private void OpenProfile()
    {
        ResetEditableFields();
        StatusMessage = string.Empty;
        SaveSucceeded = false;
        IsOpen = true;
    }

    private void CloseProfile()
    {
        ResetEditableFields();
        StatusMessage = string.Empty;
        IsOpen = false;
    }

    private async Task SaveProfile()
    {
        if (CurrentUser is null)
        {
            return;
        }

        var displayName = EditDisplayName.Trim();
        var phoneNumber = EditPhoneNumber.Trim();

        if (string.IsNullOrWhiteSpace(displayName))
        {
            SetError("Name is required.");
            return;
        }

        if (phoneNumber.Length > 0
            && !System.Text.RegularExpressions.Regex.IsMatch(phoneNumber, @"^[0-9+()\-\s]{7,32}$"))
        {
            SetError("Enter a valid phone number using numbers, spaces, +, - or brackets.");
            return;
        }

        IsSaving = true;
        StatusMessage = string.Empty;

        await using var scope = ScopeFactory.CreateAsyncScope();
        var userManager = scope.ServiceProvider.GetRequiredService<Microsoft.AspNetCore.Identity.UserManager<ApplicationUser>>();
        var databaseUser = await userManager.FindByIdAsync(CurrentUser.Id);
        if (databaseUser is null)
        {
            IsSaving = false;
            SetError("The profile could not be found. Please sign in again.");
            return;
        }

        databaseUser.DisplayName = displayName;
        databaseUser.PhoneNumber = string.IsNullOrWhiteSpace(phoneNumber) ? null : phoneNumber;
        var result = await userManager.UpdateAsync(databaseUser);
        IsSaving = false;

        if (!result.Succeeded)
        {
            SetError(string.Join(" ", result.Errors.Select(error => error.Description)));
            return;
        }

        CurrentUser = databaseUser;
        ResetEditableFields();
        SaveSucceeded = true;
        StatusMessage = "Profile saved successfully to MS SQL.";
    }

    private void ResetEditableFields()
    {
        EditDisplayName = CurrentUser?.DisplayName ?? string.Empty;
        EditPhoneNumber = CurrentUser?.PhoneNumber ?? string.Empty;
    }

    private void SetError(string message)
    {
        SaveSucceeded = false;
        StatusMessage = message;
    }

    private static string GetInitial(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "U" : name[..1].ToUpperInvariant();
}
