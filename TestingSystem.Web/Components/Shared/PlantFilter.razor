<fieldset class="plant-filter">
    <legend>Plants</legend>
    <div class="plant-filter-controls">
        <label class="filter-field">
            <span>Search and choose a plant</span>
            <input @key="SearchVersion" type="search" list="available-plants" placeholder="@SearchPlaceholder"
                   value="@PendingPlant" @onchange="AddFromSelection" disabled="@Disabled" autocomplete="off" />
            <datalist id="available-plants">
                @foreach (var plant in AvailablePlants)
                {
                    <option value="@PlantOption(plant)"></option>
                }
            </datalist>
        </label>
        <span class="plant-auto-add @(SelectedIds.Count > 0 ? "has-selection" : null)">@SelectionStatus</span>
    </div>
    <div class="plant-filter-chips" aria-live="polite">
        @foreach (var plant in Plants.Where(p => SelectedIds.Contains(p.Id)))
        {
            <button type="button" class="plant-filter-chip" @onclick="() => Remove(plant.Id)" aria-label="@($"Remove {plant.Name}")">
                @plant.Name <span aria-hidden="true">&times;</span>
            </button>
        }
    </div>
    <small>@HelpText</small>
</fieldset>

@code {
    [Parameter] public List<LssPlant> Plants { get; set; } = [];
    [Parameter] public HashSet<int> SelectedIds { get; set; } = [];
    [Parameter] public EventCallback<HashSet<int>> SelectedIdsChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private string PendingPlant = string.Empty;
    private int SearchVersion;
    private string SearchPlaceholder => SelectedIds.Count == 0
        ? "Search plant name, ID or state"
        : "Search another plant to add...";
    private string SelectionStatus => SelectedIds.Count == 0
        ? "Select from the suggestions"
        : $"{SelectedIds.Count} selected · ready for another";
    private IEnumerable<LssPlant> AvailablePlants => Plants.Where(p => !SelectedIds.Contains(p.Id));
    private static string PlantOption(LssPlant plant) => $"{plant.Name} ({plant.PlantId}) - {plant.State}";
    private string HelpText => Disabled
        ? "Plant selection is disabled because State or Region is selected."
        : Plants.Count == 0 ? "No active plants are registered."
        : SelectedIds.Count == 0 ? "No plant selected. All active plants will be included."
        : $"{SelectedIds.Count} plant(s) selected. Add more plants or remove a selection.";
    private async Task AddFromSelection(ChangeEventArgs args)
    {
        PendingPlant = args.Value?.ToString()?.Trim() ?? string.Empty;
        var plant = AvailablePlants.FirstOrDefault(p => PlantOption(p).Equals(PendingPlant, StringComparison.OrdinalIgnoreCase));
        if (plant is null) return;
        var ids = new HashSet<int>(SelectedIds) { plant.Id };
        PendingPlant = string.Empty;
        SearchVersion++;
        await SelectedIdsChanged.InvokeAsync(ids);
    }
    private Task Remove(int id) => SelectedIdsChanged.InvokeAsync(SelectedIds.Where(value => value != id).ToHashSet());
}
