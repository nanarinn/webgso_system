@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to content</a>
<div class="app-shell">
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <main class="app-main">
        <header class="app-topbar">
            <div class="environment-badge"><span></span> Secure repository</div>
            <div class="topbar-account">
                <ProfileMenu />
                <AuthorizeView>
                    <Authorized>
                        <form method="post" action="/account/logout" class="topbar-logout-form" data-enhance="false">
                            <AntiforgeryToken />
                            <button type="submit" aria-label="Sign out">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H5v16h5M14 8l4 4-4 4m4-4H9" /></svg>
                                <span>Sign out</span>
                            </button>
                        </form>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>

        <article class="app-content" id="main-content" tabindex="-1">
            @Body
        </article>

    </main>

</div>

<div id="blazor-error-ui">
    An unexpected error occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">×</a>
</div>
