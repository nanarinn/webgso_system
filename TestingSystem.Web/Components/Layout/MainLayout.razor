@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to content</a>
<div class="app-shell">
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <main class="app-main">
        <header class="app-topbar">
            <div class="environment-badge"><span></span> Secure repository</div>
            <ProfileMenu />
        </header>

        <article class="app-content" id="main-content" tabindex="-1">
            @Body
        </article>

    </main>

</div>

<div id="blazor-error-ui">
    An unexpected error occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">×</a>
</div>
