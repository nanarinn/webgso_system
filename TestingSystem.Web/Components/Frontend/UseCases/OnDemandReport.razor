@page "/on-demand-analysis"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>On-Demand Analysis | SBLSS System</PageTitle>

<div class="on-demand-page">
    <header class="page-heading">
        <div>
            <p class="section-label">Flexible analysis</p>
            <h1>On-Demand Analysis</h1>
            <p class="page-subtitle">Generate DDQ or MMF datasets for active Large Scale Solar plants, review the results and export the main data and anomaly reports.</p>
        </div>
        <button class="primary-action generate-action" type="button" @onclick="OpenGenerateDialog">
            <span class="generate-plus">+</span> Generate
        </button>
    </header>

    <section class="generation-summary">
        <button type="button" class="summary-stat" @onclick="OpenAllSummary">
            <small>Total generated</small>
            <strong>@Results.Count</strong>
            <span>View list</span>
        </button>
        <button type="button" class="summary-stat" @onclick="OpenSuccessfulSummary">
            <small>Successful</small>
            <strong>@Results.Count(result => result.Status == "Successful")</strong>
            <span>View list</span>
        </button>
        <button type="button" class="summary-stat" @onclick="OpenFailedSummary">
            <small>Failed</small>
            <strong>@Results.Count(result => result.Status == "Failed")</strong>
            <span>View list</span>
        </button>
        <p>Each request includes <b>all @ActivePlantCount active LSS plants</b>. DDQ uses a scheduled submission; MMF uses a data timestamp range.</p>
    </section>

    <section class="table-panel on-demand-panel">
        <div class="on-demand-heading">
            <div>
                <p class="section-label">Generated files</p>
                <h2>Analysis list</h2>
            </div>
            <span class="result-count">@Results.Count record(s)</span>
        </div>

        <div class="on-demand-table" role="table" aria-label="Generated on-demand analyses">
            <div class="on-demand-row on-demand-header" role="row">
                <span>Name</span>
                <span>Date &amp; timestamp generated</span>
                <span>Submission data</span>
                <span>Status</span>
                <span>View</span>
                <span>Export</span>
                <span>Anomaly report</span>
                <span>Delete</span>
            </div>
            @foreach (var result in TablePaging.Slice(Results, AnalysisPage))
            {
                <div class="on-demand-row" role="row">
                    <div class="analysis-name">
                        <strong>@result.Name</strong>
                    </div>
                    <time datetime="@result.GeneratedAt.ToString("O")">@TimeDisplay.DateTimeWithSeconds(result.GeneratedAt)</time>
                    <span class="analysis-description"><strong>@(string.IsNullOrWhiteSpace(result.DataSelection) ? (result.Type == "DDQ" ? "Rolling 24 Hour" : "All MMF parameters") : result.DataSelection)</strong><small>@(result.Type == "MMF" && result.DataRangeStart.HasValue && result.DataRangeEnd.HasValue ? $"{TimeDisplay.DateTimeLong(result.DataRangeStart.Value)} – {TimeDisplay.DateTimeLong(result.DataRangeEnd.Value)}" : TimeDisplay.DateTimeLong(result.SubmissionDate)) · @IntervalText(result.IntervalMinutes) · @ResultScopeCountLabel(result) · @result.RecordCount.ToString("N0") records</small></span>
                    <span><span class="status-pill status-@result.Status.ToLowerInvariant()">@result.Status</span></span>
                    <button class="table-action view-action" type="button" @onclick="() => ViewResult(result)">View</button>
                    <button class="table-action export-action" type="button" disabled="@(result.Status != "Successful")" @onclick="() => ExportResultAsync(result)">Export Excel</button>
                    <button class="table-action anomaly-download" type="button" disabled="@(result.Status != "Successful")" @onclick="() => ExportAnomalyResultAsync(result)">Anomaly (@result.AnomalyCount)</button>
                    <button class="table-action delete-analysis-action" type="button" @onclick="() => RequestDelete(result)">Delete</button>
                </div>
            }
        </div>
        <TablePagination TotalItems="@Results.Count" @bind-Page="AnalysisPage" />
    </section>

    @if (DeleteTarget is not null)
    {
        <div class="schedule-confirm-overlay">
            <section class="schedule-status-confirmation delete-confirmation-dialog" role="alertdialog" aria-modal="true" aria-labelledby="analysis-delete-title">
                <button class="profile-close" type="button" aria-label="Close confirmation" disabled="@IsDeleting" @onclick="CancelDelete">&#215;</button>
                <span class="schedule-status-warning">!</span>
                <div>
                    <p class="section-label">Delete analysis</p>
                    <h3 id="analysis-delete-title">Delete this generated analysis?</h3>
                    <p><b>@DeleteTarget.Name</b> and its generated record will be permanently removed from PostgreSQL. Files that were already downloaded are not affected.</p>
                    @if (!string.IsNullOrWhiteSpace(FormError)) { <div class="admin-alert error">@FormError</div> }
                    <div>
                        <button type="button" class="profile-cancel" disabled="@IsDeleting" @onclick="CancelDelete">Keep Analysis</button>
                        <button type="button" class="confirm-delete-action" disabled="@IsDeleting" @onclick="DeleteResultAsync">@(IsDeleting ? "Deleting..." : "Confirm Delete")</button>
                    </div>
                </div>
            </section>
        </div>
    }

    @if (IsSummaryDialogOpen)
    {
        <div class="summary-list-overlay" role="presentation">
            <section class="summary-list-dialog" role="dialog" aria-modal="true" aria-labelledby="analysis-summary-title">
                <div class="summary-list-header">
                    <div>
                        <p class="section-label">On-demand requests</p>
                        <h2 id="analysis-summary-title">@SummaryDialogTitle</h2>
                    </div>
                    <button class="profile-close" type="button" @onclick="CloseSummaryDialog" aria-label="Close request list">&#215;</button>
                </div>
                <div class="summary-list-body">
                    <p class="summary-list-count">@SummaryResults.Count request(s)</p>
                    @foreach (var result in TablePaging.Slice(SummaryResults, AnalysisSummaryPage))
                    {
                        <article class="summary-list-item">
                            <span class="analysis-type analysis-type-@result.Type.ToLowerInvariant()">@result.Type</span>
                            <div class="summary-item-copy">
                                <strong>@result.Name</strong>
                                <p>@result.Description</p>
                                <small>@result.Reference · @TimeDisplay.DateTimeWithSeconds(result.GeneratedAt)</small>
                            </div>
                            <span class="status-pill status-@result.Status.ToLowerInvariant()">@result.Status</span>
                        </article>
                    }
                </div>
                <TablePagination TotalItems="@SummaryResults.Count" @bind-Page="AnalysisSummaryPage" />
                <div class="summary-list-footer">
                    <button class="profile-cancel" type="button" @onclick="CloseSummaryDialog">Close</button>
                </div>
            </section>
        </div>
    }

    @if (IsGenerateDialogOpen)
    {
        <div class="on-demand-overlay" role="presentation">
            <section class="on-demand-dialog" role="dialog" aria-modal="true" aria-labelledby="generate-title">
                <div class="on-demand-dialog-header">
                    <div>
                        <p class="section-label">New request</p>
                        <h2 id="generate-title">Generate plant submission data</h2>
                    </div>
                    <button class="profile-close" type="button" @onclick="CloseGenerateDialog" aria-label="Close generate form">×</button>
                </div>

                <form @onsubmit="GenerateAnalysis" @onsubmit:preventDefault>
                    <p>DDQ uses the exact collection-schedule submission. MMF uses only the selected data timestamp range and interval.</p>
                    @if (!string.IsNullOrWhiteSpace(FormError)) { <div class="admin-alert error">@FormError</div> }
                    <InputRadioGroup @bind-Value="SelectedType" Name="analysisType" class="generation-choice">
                        <label class="analysis-choice @(SelectedType == "DDQ" ? "selected" : null)">
                            <InputRadio Value="@("DDQ")" />
                            <span>DDQ</span>
                            <small>Choose one completed collection-schedule submission.</small>
                        </label>
                        <label class="analysis-choice @(SelectedType == "MMF" ? "selected" : null)">
                            <InputRadio Value="@("MMF")" />
                            <span>MMF</span>
                            <small>Include every MMF parameter by plant, state or region.</small>
                        </label>
                    </InputRadioGroup>

                    <div class="on-demand-request-grid">
                        @if (SelectedType == "DDQ")
                        {
                            <div class="filter-field on-demand-ddq-submission-selector">
                                <span>DDQ submission</span>
                                @if (SelectedDdqSubmission is null)
                                {
                                    <input @key="DdqSubmissionSearchVersion" type="search" list="on-demand-ddq-submissions"
                                           placeholder="Search date, time, DDQ type or schedule"
                                           value="@PendingDdqSubmission" @onchange="SelectDdqSubmission" autocomplete="off" />
                                    <datalist id="on-demand-ddq-submissions">
                                        @foreach (var option in AvailableDdqSubmissionOptions)
                                        {
                                            <option value="@DdqSubmissionOptionText(option)"></option>
                                        }
                                    </datalist>
                                    <small>Select one completed submission from Collection Schedule.</small>
                                }
                                else
                                {
                                    <button type="button" class="on-demand-selected-submission" @onclick="RemoveDdqSubmission">
                                        <span><strong>@SelectedDdqSubmission.DataType</strong><small>@TimeDisplay.DateTime(SelectedDdqSubmission.SubmissionDateTime) · @SelectedDdqSubmission.PlantCount plant(s)</small></span>
                                        <b aria-hidden="true">×</b>
                                    </button>
                                    <small>Remove this selection to choose another submission.</small>
                                }
                            </div>
                        }
                        else
                        {
                            <label class="filter-field"><span>MMF data</span><input value="All MMF parameters" readonly /><small>Every available parameter is included at the selected interval.</small></label>
                        }
                        <label class="filter-field"><span>Data interval</span><select @bind="SelectedInterval">@foreach (var interval in DataIntervals) { <option value="@interval.Value">@interval.Label</option> }</select><small>Only timestamps aligned with this interval are included.</small></label>
                    </div>
                    @if (SelectedType == "MMF")
                    {
                        <fieldset class="on-demand-mmf-scope">
                            <legend>MMF result scope</legend>
                            <InputRadioGroup @bind-Value="MmfLocationScope" Name="mmfLocationScope" class="mmf-scope-options">
                                <label class="mmf-scope-option @(MmfLocationScope == "All Plants" ? "selected" : null)">
                                    <InputRadio Value="@("All Plants")" /><span><strong>All Plants</strong><small>One result row for every active LSS plant.</small></span>
                                </label>
                                <label class="mmf-scope-option @(MmfLocationScope == "All States" ? "selected" : null)">
                                    <InputRadio Value="@("All States")" /><span><strong>All States</strong><small>Average plant readings into one row per state.</small></span>
                                </label>
                                <label class="mmf-scope-option @(MmfLocationScope == "All Regions" ? "selected" : null)">
                                    <InputRadio Value="@("All Regions")" /><span><strong>All Regions</strong><small>Average plant readings into one row per region.</small></span>
                                </label>
                            </InputRadioGroup>
                        </fieldset>
                        <fieldset class="on-demand-mmf-range">
                            <legend><span class="range-step">3</span><span><strong>MMF data range</strong><small>Select the exact start and end date and time.</small></span></legend>
                            <div class="on-demand-date-pair">
                                <div class="date-time-control">
                                    <span>Start</span>
                                    <div>
                                        <label><small>Date</small><span class="sblss-picker"><span class="sblss-picker-copy"><b>@MmfStartDateInput.ToString("dd/MM/yyyy")</b><small>day/month/year</small></span><span class="sblss-picker-icon" aria-hidden="true">▣</span><input class="sblss-picker-native" aria-label="MMF start date in day month year format" type="date" required @bind="MmfStartDateInput" @bind:format="yyyy-MM-dd" /></span></label>
                                        <label><small>Time</small><span class="sblss-picker sblss-picker-time"><span class="sblss-picker-copy"><b>@TimeDisplay.TwentyFourHour(MmfStartTimeInput)</b><small>24-hour time</small></span><span class="sblss-picker-icon sblss-clock-icon" aria-hidden="true">◷</span><input class="sblss-picker-native" aria-label="MMF start time in 24 hour format" type="time" required step="900" @bind="MmfStartTimeInput" /></span></label>
                                    </div>
                                </div>
                                <div class="date-time-control">
                                    <span>End</span>
                                    <div>
                                        <label><small>Date</small><span class="sblss-picker"><span class="sblss-picker-copy"><b>@MmfEndDateInput.ToString("dd/MM/yyyy")</b><small>day/month/year</small></span><span class="sblss-picker-icon" aria-hidden="true">▣</span><input class="sblss-picker-native" aria-label="MMF end date in day month year format" type="date" required @bind="MmfEndDateInput" @bind:format="yyyy-MM-dd" /></span></label>
                                        <label><small>Time</small><span class="sblss-picker sblss-picker-time"><span class="sblss-picker-copy"><b>@TimeDisplay.TwentyFourHour(MmfEndTimeInput)</b><small>24-hour time</small></span><span class="sblss-picker-icon sblss-clock-icon" aria-hidden="true">◷</span><input class="sblss-picker-native" aria-label="MMF end time in 24 hour format" type="time" required step="900" @bind="MmfEndTimeInput" /></span></label>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    }
                    <div class="on-demand-all-plants"><span>&#10003;</span><div><strong>@(SelectedType == "DDQ" ? "All active LSS plants included" : $"{MmfLocationScope} included")</strong><small>The generated file will use available data from @ActivePlantCount configured active plant(s) at @IntervalText(SelectedInterval) interval.</small></div></div>

                    <div class="profile-actions">
                        <button class="profile-cancel" type="button" disabled="@IsGenerating" @onclick="CloseGenerateDialog">Cancel</button>
                        <button class="primary-action generate-action" type="submit" disabled="@IsGenerating">
                            @(IsGenerating ? "Generating..." : "Generate Analysis") <span>→</span>
                        </button>
                    </div>
                </form>
            </section>
        </div>
    }

    @if (SelectedResult is not null)
    {
        <div class="on-demand-overlay" role="presentation">
            <section class="on-demand-dialog result-dialog result-preview-dialog" role="dialog" aria-modal="true" aria-labelledby="result-title">
                <div class="on-demand-dialog-header">
                    <div>
                        <p class="section-label">@(IsAnomalyPreview ? "Anomaly preview" : "Excel data preview")</p>
                        <h2 id="result-title">@SelectedResult.Name</h2>
                    </div>
                    <div class="result-preview-header-actions">
                        @if (IsAnomalyPreview)
                        {
                            <button class="table-action anomaly-preview-toggle" type="button" disabled="@IsPreviewLoading" @onclick="ShowDataPreview">View Data</button>
                        }
                        else
                        {
                            <button class="table-action anomaly-preview-toggle" type="button" disabled="@(IsPreviewLoading || SelectedResult.Status != "Successful")" @onclick="ShowAnomalyPreview">View Anomaly (@SelectedResult.AnomalyCount)</button>
                        }
                        <button class="table-action anomaly-download" type="button" disabled="@(SelectedResult.Status != "Successful")" @onclick="() => ExportAnomalyResultAsync(SelectedResult)">Export Anomaly (@SelectedResult.AnomalyCount)</button>
                        <button class="primary-action generate-action" type="button" disabled="@(SelectedResult.Status != "Successful")" @onclick="() => ExportResultAsync(SelectedResult)">Export Excel <span>↓</span></button>
                        <button class="profile-close" type="button" @onclick="CloseResult" aria-label="Close data preview">×</button>
                    </div>
                </div>

                <div class="result-dialog-body">
                    <div class="result-preview-summary">
                        <span class="analysis-type analysis-type-@SelectedResult.Type.ToLowerInvariant()">@SelectedResult.Type</span>
                        <span><small>Reference</small><strong>@SelectedResult.Reference</strong></span>
                        @if (SelectedResult.Type == "MMF" && SelectedResult.DataRangeStart.HasValue && SelectedResult.DataRangeEnd.HasValue)
                        {
                            <span><small>Selected data range</small><strong>@TimeDisplay.DateTime(SelectedResult.DataRangeStart.Value) – @TimeDisplay.DateTime(SelectedResult.DataRangeEnd.Value)</strong></span>
                        }
                        <span><small>Interval</small><strong>@IntervalText(SelectedResult.IntervalMinutes)</strong></span>
                        <span><small>Records</small><strong>@SelectedResult.RecordCount.ToString("N0")</strong></span>
                        <span><small>Anomalies</small><strong>@SelectedResult.AnomalyCount.ToString("N0")</strong></span>
                    </div>

                    @if (IsPreviewLoading)
                    {
                        <div class="result-preview-state" role="status">
                            <span class="result-preview-spinner" aria-hidden="true"></span>
                            <strong>Preparing Excel preview…</strong>
                            <small>Reading the stored analysis data from PostgreSQL.</small>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(PreviewError))
                    {
                        <div class="result-preview-state result-preview-error" role="alert">
                            <strong>Preview unavailable</strong>
                            <small>@PreviewError</small>
                        </div>
                    }
                    else if (SelectedPreviewSheet is not null)
                    {
                        @if (!IsAnomalyPreview && PreviewSheets.Count > 1)
                        {
                            <nav class="result-sheet-tabs" aria-label="Excel worksheets">
                                @for (var index = 0; index < PreviewSheets.Count; index++)
                                {
                                    var sheetIndex = index;
                                    <button type="button" class="@(SelectedPreviewSheetIndex == sheetIndex ? "active" : null)"
                                            @onclick="() => SelectPreviewSheet(sheetIndex)">@PreviewSheets[sheetIndex].Name</button>
                                }
                            </nav>
                        }
                        @if (IsAnomalyPreview && SelectedPreviewSheet.Rows.Count == 0)
                        {
                            <div class="result-preview-state anomaly-preview-empty" role="status">
                                <strong>No anomalies found</strong>
                                <small>This analysis has no validation anomaly or report substitution record.</small>
                            </div>
                        }
                        else
                        {
                        <section class="result-workbook-preview @(IsAnomalyPreview ? "anomaly-workbook-preview" : null)">
                            <div class="result-workbook-title">@SelectedPreviewSheet.Title</div>
                            <div class="result-workbook-meta">
                                @foreach (var item in SelectedPreviewSheet.Metadata)
                                {
                                    <span><small>@item.Label</small><strong>@item.Value</strong></span>
                                }
                            </div>
                            <div class="result-workbook-scroll">
                                <table>
                                    <thead><tr>@foreach (var header in SelectedPreviewSheet.Headers) { <th>@header</th> }</tr></thead>
                                    <tbody>
                                        @foreach (var row in SelectedPreviewSheet.Rows)
                                        {
                                            <tr>@foreach (var cell in row) { <td class="@(cell is null ? "empty-cell" : null)">@PreviewCell(cell)</td> }</tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                        }
                    }

                    <div class="profile-actions result-preview-actions">
                        <button class="profile-cancel" type="button" @onclick="CloseResult">Close</button>
                    </div>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private int AnalysisPage { get; set; } = 1;
    private int AnalysisSummaryPage { get; set; } = 1;
}
