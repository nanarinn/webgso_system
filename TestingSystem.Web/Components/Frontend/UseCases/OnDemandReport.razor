@page "/on-demand-analysis"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>On-Demand Analysis | SBLSS System</PageTitle>

<div class="on-demand-page">
    <header class="page-heading">
        <div>
            <p class="section-label">Flexible analysis</p>
            <h1>On-Demand Analysis</h1>
            <p class="page-subtitle">Generate DDQ or MMF datasets for active Large Scale Solar plants, review the results and export the main and anomaly CSV reports.</p>
        </div>
        <button class="primary-action generate-action" type="button" @onclick="OpenGenerateDialog">
            <span class="generate-plus">+</span> Generate
        </button>
    </header>

    <section class="generation-summary">
        <button type="button" class="summary-stat" @onclick="OpenAllSummary">
            <small>Total generated</small>
            <strong>@Results.Count</strong>
            <span>View list</span>
        </button>
        <button type="button" class="summary-stat" @onclick="OpenSuccessfulSummary">
            <small>Successful</small>
            <strong>@Results.Count(result => result.Status == "Successful")</strong>
            <span>View list</span>
        </button>
        <button type="button" class="summary-stat" @onclick="OpenFailedSummary">
            <small>Failed</small>
            <strong>@Results.Count(result => result.Status == "Failed")</strong>
            <span>View list</span>
        </button>
        <p>Each request includes <b>all @ActivePlantCount active LSS plants</b>. DDQ uses a scheduled submission; MMF uses a data timestamp range.</p>
    </section>

    <section class="table-panel on-demand-panel">
        <div class="on-demand-heading">
            <div>
                <p class="section-label">Generated files</p>
                <h2>Analysis list</h2>
            </div>
            <span class="result-count">@Results.Count record(s)</span>
        </div>

        <div class="on-demand-table" role="table" aria-label="Generated on-demand analyses">
            <div class="on-demand-row on-demand-header" role="row">
                <span>Name</span>
                <span>Date &amp; timestamp generated</span>
                <span>Submission data</span>
                <span>Status</span>
                <span>View</span>
                <span>Export</span>
                <span>Anomaly report</span>
            </div>
            @foreach (var result in TablePaging.Slice(Results, AnalysisPage))
            {
                <div class="on-demand-row" role="row">
                    <div class="analysis-name">
                        <span class="analysis-type analysis-type-@result.Type.ToLowerInvariant()">@result.Type</span>
                        <strong>@result.Name</strong>
                    </div>
                    <time datetime="@result.GeneratedAt.ToString("O")">@TimeDisplay.DateTimeWithSeconds(result.GeneratedAt)</time>
                    <span class="analysis-description"><strong>@(string.IsNullOrWhiteSpace(result.DataSelection) ? (result.Type == "DDQ" ? "Rolling 24 Hour" : "All MMF parameters") : result.DataSelection)</strong><small>@(result.Type == "MMF" && result.DataRangeStart.HasValue && result.DataRangeEnd.HasValue ? $"{TimeDisplay.DateTimeLong(result.DataRangeStart.Value)} – {TimeDisplay.DateTimeLong(result.DataRangeEnd.Value)}" : TimeDisplay.DateTimeLong(result.SubmissionDate)) · @IntervalText(result.IntervalMinutes) · @(result.PlantCount > 0 ? result.PlantCount : ActivePlantCount) plant(s) · @result.RecordCount.ToString("N0") records</small></span>
                    <span><span class="status-pill status-@result.Status.ToLowerInvariant()">@result.Status</span></span>
                    <button class="table-action view-action" type="button" @onclick="() => ViewResult(result)">View</button>
                    <button class="table-action export-action" type="button" disabled="@(result.Status != "Successful")" @onclick="() => ExportResultAsync(result)">Export CSV</button>
                    <button class="table-action anomaly-download" type="button" disabled="@(result.Status != "Successful")" @onclick="() => ExportAnomalyResultAsync(result)">Anomaly (@result.AnomalyCount)</button>
                </div>
            }
        </div>
        <TablePagination TotalItems="@Results.Count" @bind-Page="AnalysisPage" />
    </section>

    @if (IsSummaryDialogOpen)
    {
        <div class="summary-list-overlay" role="presentation">
            <section class="summary-list-dialog" role="dialog" aria-modal="true" aria-labelledby="analysis-summary-title">
                <div class="summary-list-header">
                    <div>
                        <p class="section-label">On-demand requests</p>
                        <h2 id="analysis-summary-title">@SummaryDialogTitle</h2>
                    </div>
                    <button class="profile-close" type="button" @onclick="CloseSummaryDialog" aria-label="Close request list">&#215;</button>
                </div>
                <div class="summary-list-body">
                    <p class="summary-list-count">@SummaryResults.Count request(s)</p>
                    @foreach (var result in TablePaging.Slice(SummaryResults, AnalysisSummaryPage))
                    {
                        <article class="summary-list-item">
                            <span class="analysis-type analysis-type-@result.Type.ToLowerInvariant()">@result.Type</span>
                            <div class="summary-item-copy">
                                <strong>@result.Name</strong>
                                <p>@result.Description</p>
                                <small>@result.Reference · @TimeDisplay.DateTimeWithSeconds(result.GeneratedAt)</small>
                            </div>
                            <span class="status-pill status-@result.Status.ToLowerInvariant()">@result.Status</span>
                        </article>
                    }
                </div>
                <TablePagination TotalItems="@SummaryResults.Count" @bind-Page="AnalysisSummaryPage" />
                <div class="summary-list-footer">
                    <button class="profile-cancel" type="button" @onclick="CloseSummaryDialog">Close</button>
                </div>
            </section>
        </div>
    }

    @if (IsGenerateDialogOpen)
    {
        <div class="on-demand-overlay" role="presentation">
            <section class="on-demand-dialog" role="dialog" aria-modal="true" aria-labelledby="generate-title">
                <div class="on-demand-dialog-header">
                    <div>
                        <p class="section-label">New request</p>
                        <h2 id="generate-title">Generate plant submission data</h2>
                    </div>
                    <button class="profile-close" type="button" @onclick="CloseGenerateDialog" aria-label="Close generate form">×</button>
                </div>

                <form @onsubmit="GenerateAnalysis" @onsubmit:preventDefault>
                    <p>DDQ uses the exact collection-schedule submission. MMF uses only the selected data timestamp range and interval.</p>
                    @if (!string.IsNullOrWhiteSpace(FormError)) { <div class="admin-alert error">@FormError</div> }
                    <InputRadioGroup @bind-Value="SelectedType" Name="analysisType" class="generation-choice">
                        <label class="analysis-choice @(SelectedType == "DDQ" ? "selected" : null)">
                            <InputRadio Value="@("DDQ")" />
                            <span>DDQ</span>
                            <small>Choose one DDQ forecast data type for all plants.</small>
                        </label>
                        <label class="analysis-choice @(SelectedType == "MMF" ? "selected" : null)">
                            <InputRadio Value="@("MMF")" />
                            <span>MMF</span>
                            <small>Include every available MMF parameter for all plants.</small>
                        </label>
                    </InputRadioGroup>

                    <div class="on-demand-request-grid">
                        @if (SelectedType == "DDQ")
                        {
                            <label class="filter-field"><span>DDQ data type</span><select value="@SelectedDataType" @onchange="OnDdqDataTypeChanged">@foreach (var type in DdqDataTypes) { <option value="@type">@type</option> }</select><small>Select one forecast dataset. The latest available submission is selected automatically.</small></label>
                        }
                        else
                        {
                            <label class="filter-field"><span>MMF data</span><input value="All MMF parameters" readonly /><small>Every available parameter is included at the selected interval.</small></label>
                        }
                        <label class="filter-field"><span>Data interval</span><select @bind="SelectedInterval">@foreach (var interval in DataIntervals) { <option value="@interval.Value">@interval.Label</option> }</select><small>Only timestamps aligned with this interval are included.</small></label>
                        @if (SelectedType == "DDQ")
                        {
                            <label class="filter-field"><span>Submission date &amp; time</span><span class="sblss-picker sblss-picker-datetime"><span class="sblss-picker-copy"><b>@SelectedSubmissionDate.ToString("dd/MM/yyyy") @TimeDisplay.TwentyFourHour(SelectedSubmissionDate)</b><small>day/month/year · 24-hour time</small></span><span class="sblss-picker-icon" aria-hidden="true">▣</span><input class="sblss-picker-native" aria-label="Submission date and time in day month year and 24 hour format" type="datetime-local" max="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" @bind="SelectedSubmissionDate" @bind:format="yyyy-MM-ddTHH:mm" required /></span><small>Use the exact date and time configured by the collection schedule.</small></label>
                        }
                    </div>
                    @if (SelectedType == "MMF")
                    {
                        <fieldset class="on-demand-mmf-range">
                            <legend><span class="range-step">MMF</span><span><strong>Data timestamp range</strong><small>Choose the MMF readings to include in this analysis.</small></span></legend>
                            <div class="on-demand-range-grid">
                                <label class="filter-field"><span>Start date &amp; time</span><span class="sblss-picker sblss-picker-datetime"><span class="sblss-picker-copy"><b>@MmfRangeStart.ToString("dd/MM/yyyy") @TimeDisplay.TwentyFourHour(MmfRangeStart)</b><small>day/month/year · 24-hour time</small></span><span class="sblss-picker-icon" aria-hidden="true">▣</span><input class="sblss-picker-native" aria-label="MMF start date and time in day month year and 24 hour format" type="datetime-local" required max="@MmfRangeEnd.ToString("yyyy-MM-ddTHH:mm")" @bind="MmfRangeStart" @bind:format="yyyy-MM-ddTHH:mm" /></span><small>First MMF timestamp included.</small></label>
                                <span class="range-flow" aria-hidden="true">&#8594;</span>
                                <label class="filter-field"><span>End date &amp; time</span><span class="sblss-picker sblss-picker-datetime"><span class="sblss-picker-copy"><b>@MmfRangeEnd.ToString("dd/MM/yyyy") @TimeDisplay.TwentyFourHour(MmfRangeEnd)</b><small>day/month/year · 24-hour time</small></span><span class="sblss-picker-icon" aria-hidden="true">▣</span><input class="sblss-picker-native" aria-label="MMF end date and time in day month year and 24 hour format" type="datetime-local" required min="@MmfRangeStart.ToString("yyyy-MM-ddTHH:mm")" @bind="MmfRangeEnd" @bind:format="yyyy-MM-ddTHH:mm" /></span><small>Last MMF timestamp included.</small></label>
                            </div>
                        </fieldset>
                    }
                    <div class="on-demand-all-plants"><span>&#10003;</span><div><strong>All active LSS plants included</strong><small>The generated file will combine available data from @ActivePlantCount configured active plant(s) at @IntervalText(SelectedInterval) interval.</small></div></div>

                    <div class="profile-actions">
                        <button class="profile-cancel" type="button" disabled="@IsGenerating" @onclick="CloseGenerateDialog">Cancel</button>
                        <button class="primary-action generate-action" type="submit" disabled="@IsGenerating">
                            @(IsGenerating ? "Generating..." : "Generate Analysis") <span>→</span>
                        </button>
                    </div>
                </form>
            </section>
        </div>
    }

    @if (SelectedResult is not null)
    {
        <div class="on-demand-overlay" role="presentation">
            <section class="on-demand-dialog result-dialog" role="dialog" aria-modal="true" aria-labelledby="result-title">
                <div class="on-demand-dialog-header">
                    <div>
                        <p class="section-label">Analysis details</p>
                        <h2 id="result-title">@SelectedResult.Name</h2>
                    </div>
                    <button class="profile-close" type="button" @onclick="CloseResult" aria-label="Close analysis details">×</button>
                </div>

                <div class="result-dialog-body">
                    <div class="result-status-banner status-banner-@SelectedResult.Status.ToLowerInvariant()">
                        <span class="analysis-type analysis-type-@SelectedResult.Type.ToLowerInvariant()">@SelectedResult.Type</span>
                        <div>
                            <strong>@SelectedResult.Status</strong>
                            <small>Generation reference @SelectedResult.Reference</small>
                        </div>
                    </div>
                    <dl class="result-details">
                        @if (SelectedResult.Type == "DDQ")
                        {
                            <div><dt>Submission date &amp; time</dt><dd>@TimeDisplay.DateTimeLong(SelectedResult.SubmissionDate)</dd></div>
                        }
                        <div><dt>Generated at</dt><dd>@TimeDisplay.DateTimeWithSeconds(SelectedResult.GeneratedAt)</dd></div>
                        <div><dt>Data selection</dt><dd>@(string.IsNullOrWhiteSpace(SelectedResult.DataSelection) ? (SelectedResult.Type == "DDQ" ? "Rolling 24 Hour" : "All MMF parameters") : SelectedResult.DataSelection)</dd></div>
                        <div><dt>Data interval</dt><dd>@IntervalText(SelectedResult.IntervalMinutes)</dd></div>
                        @if (SelectedResult.Type == "MMF" && SelectedResult.DataRangeStart.HasValue && SelectedResult.DataRangeEnd.HasValue)
                        {
                            <div class="result-description-row"><dt>Data timestamp range</dt><dd>@TimeDisplay.DateTimeLong(SelectedResult.DataRangeStart.Value) – @TimeDisplay.DateTimeLong(SelectedResult.DataRangeEnd.Value)</dd></div>
                        }
                        <div><dt>Plants and records</dt><dd>@(SelectedResult.PlantCount > 0 ? SelectedResult.PlantCount : ActivePlantCount) plant(s) · @SelectedResult.RecordCount.ToString("N0") record(s)</dd></div>
                        <div><dt>Anomalies found</dt><dd>@SelectedResult.AnomalyCount.ToString("N0")</dd></div>
                        <div class="result-description-row"><dt>Description</dt><dd>@SelectedResult.Description</dd></div>
                    </dl>
                    <div class="profile-actions">
                        <button class="profile-cancel" type="button" @onclick="CloseResult">Close</button>
                        <button class="table-action anomaly-download" type="button" disabled="@(SelectedResult.Status != "Successful")" @onclick="() => ExportAnomalyResultAsync(SelectedResult)">Download Anomaly CSV (@SelectedResult.AnomalyCount)</button>
                        <button class="primary-action generate-action" type="button" disabled="@(SelectedResult.Status != "Successful")" @onclick="() => ExportResultAsync(SelectedResult)">Export CSV <span>↓</span></button>
                    </div>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private int AnalysisPage { get; set; } = 1;
    private int AnalysisSummaryPage { get; set; } = 1;
}
