@page "/admin/audit-logs"
@attribute [Authorize(Roles = "SuperAdministrator,Administrator")]
@rendermode InteractiveServer

<PageTitle>Audit Logs | SBLSS System</PageTitle>

<div class="admin-page audit-page">
    <header class="page-heading">
        <div><p class="section-label">Security &amp; Operations</p><h1>Audit and Operational Events</h1>
            <p class="page-subtitle">Filter sign-in, download, security, administration and automated system events stored in PostgreSQL.</p></div>
        <button type="button" class="audit-export-button" @onclick="OpenExportForm">
            <span class="audit-export-icon" aria-hidden="true"><i></i></span>
            <span class="audit-export-label"><strong>Export events</strong><small>Filter and download CSV</small></span>
            <span class="audit-export-arrow" aria-hidden="true">&#8594;</span>
        </button>
    </header>
    <section class="audit-filter-panel" aria-labelledby="audit-filter-title">
        <div class="audit-filter-heading"><div><p class="section-label">Event filters</p><h2 id="audit-filter-title">Find audit events</h2><small>Use one or more fields to narrow the event list.</small></div><span class="result-count">@FilteredEvents.Count record(s)</span></div>
        <div class="audit-filter-grid">
            <label class="admin-search audit-search"><span>&#8981;</span><input type="search" placeholder="Search actor, action, reference or detail..." @bind="SearchTerm" @bind:event="oninput" @bind:after="ResetAuditPage" /></label>
            <label class="report-filter"><span>Actor</span><select @bind="ActorFilter" @bind:after="ResetAuditPage"><option value="All">All actors</option>@foreach (var actor in AvailableActors) { <option value="@actor">@actor</option> }</select></label>
            <label class="report-filter"><span>Event / action</span><select @bind="ActionFilter" @bind:after="ResetAuditPage"><option value="All">All events</option>@foreach (var action in AvailableActions) { <option value="@action">@action</option> }</select></label>
            <label class="report-filter"><span>Result</span><select @bind="ResultFilter" @bind:after="ResetAuditPage"><option value="All">All results</option><option value="Success">Success</option><option value="Failed">Failed</option><option value="Warning">Warning</option><option value="Pending">Pending</option></select></label>
            <label class="report-filter"><span>From date</span><span class="sblss-picker"><span class="sblss-picker-copy"><b>@(FromDate?.ToString("dd/MM/yyyy") ?? "DD/MM/YYYY")</b><small>day/month/year</small></span><span class="sblss-picker-icon" aria-hidden="true">▣</span><input class="sblss-picker-native" aria-label="Audit from date in day month year format" type="date" max="@ToDate?.ToString("yyyy-MM-dd")" @bind="FromDate" @bind:after="ResetAuditPage" /></span></label>
            <label class="report-filter"><span>To date</span><span class="sblss-picker"><span class="sblss-picker-copy"><b>@(ToDate?.ToString("dd/MM/yyyy") ?? "DD/MM/YYYY")</b><small>day/month/year</small></span><span class="sblss-picker-icon" aria-hidden="true">▣</span><input class="sblss-picker-native" aria-label="Audit to date in day month year format" type="date" min="@FromDate?.ToString("yyyy-MM-dd")" @bind="ToDate" @bind:after="ResetAuditPage" /></span></label>
        </div>
        <div class="audit-filter-footer"><span>Filters update the table immediately.</span><button type="button" class="audit-clear" @onclick="ClearFilters">Clear all filters</button></div>
    </section>
    <section class="table-panel">
        <div class="report-table" role="table" aria-label="Audit events">
            <div class="report-row report-header" role="row"><span>Timestamp</span><span>Actor</span><span>Action</span><span>Reference</span><span>Result</span><span>Detail</span></div>
            @if (FilteredEvents.Count == 0) { <div class="collection-empty"><strong>No audit events found</strong><span>Change the search or result filter.</span></div> }
            @foreach (var item in TablePaging.Slice(FilteredEvents, AuditPage))
            {
                <div class="report-row" role="row"><span>@TimeDisplay.DateTimeWithSeconds(item.OccurredAt)</span><span>@item.Actor</span><span>@item.Action</span><span>@(item.EntityReference ?? "-")</span><span class="status-pill status-@item.Result.ToLowerInvariant()">@item.Result</span><span>@(item.Detail ?? "-")</span></div>
            }
        </div>
        <TablePagination TotalItems="@FilteredEvents.Count" @bind-Page="AuditPage" />
    </section>
</div>

@if (ExportFormOpen)
{
    <div class="audit-export-overlay">
        <section class="audit-export-modal" role="dialog" aria-modal="true" aria-labelledby="audit-export-title">
            <header><div><p class="section-label">Filtered export</p><h2 id="audit-export-title">Export audit events</h2><p>Select the event and period before generating the CSV file.</p></div><button type="button" aria-label="Close" disabled="@IsExporting" @onclick="() => ExportFormOpen = false">&#215;</button></header>
            <form @onsubmit="ExportFilteredEventsAsync" @onsubmit:preventDefault>
                @if (ExportError is not null) { <div class="quality-form-error" role="alert">@ExportError</div> }
                <div class="audit-export-grid">
                    <label class="report-filter export-event-field"><span>Event / action *</span><select required @bind="ExportAction"><option value="">Select an event</option>@foreach (var action in AvailableActions) { <option value="@action">@action</option> }</select><small>Only this event type will be included.</small></label>
                    <label class="report-filter"><span>Actor</span><select @bind="ExportActor"><option value="All">All actors</option>@foreach (var actor in AvailableActors) { <option value="@actor">@actor</option> }</select></label>
                    <label class="report-filter"><span>Result</span><select @bind="ExportResult"><option value="All">All results</option><option value="Success">Success</option><option value="Failed">Failed</option><option value="Warning">Warning</option><option value="Pending">Pending</option></select></label>
                    <label class="report-filter"><span>From date *</span><span class="sblss-picker"><span class="sblss-picker-copy"><b>@(ExportFromDate?.ToString("dd/MM/yyyy") ?? "DD/MM/YYYY")</b><small>day/month/year</small></span><span class="sblss-picker-icon" aria-hidden="true">▣</span><input class="sblss-picker-native" aria-label="Export from date in day month year format" type="date" required max="@ExportToDate?.ToString("yyyy-MM-dd")" @bind="ExportFromDate" /></span></label>
                    <label class="report-filter"><span>To date *</span><span class="sblss-picker"><span class="sblss-picker-copy"><b>@(ExportToDate?.ToString("dd/MM/yyyy") ?? "DD/MM/YYYY")</b><small>day/month/year</small></span><span class="sblss-picker-icon" aria-hidden="true">▣</span><input class="sblss-picker-native" aria-label="Export to date in day month year format" type="date" required min="@ExportFromDate?.ToString("yyyy-MM-dd")" @bind="ExportToDate" /></span></label>
                </div>
                <div class="audit-export-note"><span>i</span><p>The CSV contains only events matching this form. The download is also recorded in the audit log.</p></div>
                <footer><button type="button" class="quality-secondary-button" disabled="@IsExporting" @onclick="() => ExportFormOpen = false">Cancel</button><button type="submit" class="audit-export-confirm" disabled="@IsExporting">@(IsExporting ? "Preparing..." : "Export filtered CSV") <span>↓</span></button></footer>
            </form>
        </section>
    </div>
}

@code { private int AuditPage { get; set; } = 1; }
