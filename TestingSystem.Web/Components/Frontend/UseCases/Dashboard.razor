@page "/"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Overview | Single Buyer LSS Repository</PageTitle>

<header class="page-heading">
    <div>
        <p class="section-label">Repository overview</p>
        <h1>Large Scale Solar portfolio</h1>
        <p class="page-subtitle">Monitor configured Large Scale Solar plants, DDQ collection outcomes, active MMF endpoints and recent API activity.</p>
    </div>
</header>

@if (IsDashboardLoading)
{
    <div class="page-inline-notice" role="status">Loading repository data from the secured application service…</div>
}
else if (!string.IsNullOrWhiteSpace(DashboardLoadError))
{
    <div class="page-inline-error dashboard-load-error" role="alert">
        <span>@DashboardLoadError</span>
        <button class="secondary-action" type="button" disabled="@IsReloading" @onclick="ReloadDashboardAsync">
            @(IsReloading ? "Trying again…" : "Try again")
        </button>
    </div>
}

<section class="dashboard-overview-summary" aria-label="Operational summary">
    <button class="metric-card metric-card-blue" type="button" disabled="@(!DashboardDataAvailable)"
            @onclick="() => OpenMetric(PlantMetricTitle, PlantMetricDescription, PlantItems)">
        <div>
            <strong>@MetricValue(TotalPlants)</strong>
            <span>Total plants</span>
        </div>
    </button>

    <section class="dashboard-ddq-compact" aria-label="DDQ collection status by data type">
        <header>
            <div><h2>DDQ Collection Status</h2></div>
            <a href="collection-management">View history</a>
        </header>
        <div class="dashboard-ddq-compact-list">
            @foreach (var summary in DdqTypes)
            {
                <div class="dashboard-ddq-compact-row">
                    <div class="dashboard-ddq-type"><i></i><strong>@summary.DataType</strong></div>
                    <time><small>Last pull</small><span>@(summary.LastCollectedAt.HasValue ? TimeDisplay.DateTimeWithSeconds(summary.LastCollectedAt.Value) : "No collection yet")</span></time>
                    <button class="dashboard-ddq-count success" type="button" disabled="@(!DashboardDataAvailable)" title="View successful collections" @onclick='() => OpenDdqMetric(summary, "Successful")'><span>Successful</span><strong>@summary.SuccessfulCount</strong></button>
                    <button class="dashboard-ddq-count failed" type="button" disabled="@(!DashboardDataAvailable)" title="View failed collections" @onclick='() => OpenDdqMetric(summary, "Failed")'><span>Failed</span><strong>@summary.FailedCount</strong></button>
                </div>
            }
        </div>
    </section>
</section>

<section class="content-grid">
    <article class="panel panel-wide">
        <div class="panel-heading">
            <div>
                <p class="section-label">Recently updated</p>
                <h2>Latest collection records</h2>
            </div>
            <a href="collection-management">View all</a>
        </div>

        <div class="record-list">
            @foreach (var record in RecentRecords)
            {
                <div class="record-row dashboard-record-row">
                    <span class="record-code" title="@record.Reference">@record.DisplayReference</span>
                    <div class="record-name">
                        <strong>@record.PlantName</strong>
                        <span>@record.DataType collection</span>
                    </div>
                    <span class="status-pill status-@record.Status.ToLowerInvariant()">@record.Status</span>
                    <time datetime="@record.UpdatedAt.ToString("O")">@record.UpdatedAt.ToString("dd MMM yyyy")</time>
                </div>
            }
        </div>
    </article>

    <aside class="panel focus-panel">
        <p class="section-label section-label-light">System status</p>
        <h2>@(RepositoryStatus?.Connected == true ? "Repository connected" : RepositoryStatus is null ? "Status unavailable" : "Repository unavailable")</h2>
        <p>Blazor reads this dashboard through the secured server application service.</p>
        <div class="connection-line @(RepositoryStatus is null ? "connection-unknown" : RepositoryStatus.Connected ? "connection-online" : "connection-offline")">
            <span></span>
            @(RepositoryStatus is null ? "Database status not confirmed" : RepositoryStatus.Connected ? "Configured PostgreSQL online" : "Configured PostgreSQL unavailable")
        </div>
        <button class="health-proof-button" type="button" @onclick="OpenHealthStatus">View health status <span>→</span></button>
    </aside>
</section>

@if (IsHealthStatusOpen)
{
    <div class="metric-modal-overlay health-modal-overlay" role="presentation">
        <section class="metric-dialog health-status-dialog" role="dialog" aria-modal="true" aria-labelledby="health-status-title">
            <div class="metric-dialog-header">
                <div>
                    <p class="section-label">System status</p>
                    <h2 id="health-status-title">@(RepositoryStatus?.Connected == true ? "Repository is healthy" : RepositoryStatus is null ? "System status unavailable" : "Repository needs attention")</h2>
                    <p>@(string.IsNullOrWhiteSpace(DashboardStatusError) ? "Status retrieved through the authorised application service." : DashboardStatusError)</p>
                </div>
                <button class="profile-close" type="button" @onclick="CloseHealthStatus" aria-label="Close system status">×</button>
            </div>
            <div class="health-status-content @(RepositoryStatus?.Connected == true ? "health-status-connected" : "health-status-disconnected")">
                <span class="health-status-icon @(RepositoryStatus?.Connected == true ? "health-status-available" : "health-status-unavailable")" aria-hidden="true">@(RepositoryStatus?.Connected == true ? "✓" : "!")</span>
                <div>
                    <strong>@(RepositoryStatus?.Connected == true ? "Web app, backend API and configured database are connected" : RepositoryStatus is null ? "The backend health status could not be confirmed" : "The backend cannot connect to the configured database")</strong>
                    <p>@(RepositoryStatus is null ? "Check the backend API and server logs." : $"The backend reported {RepositoryStatus.Plants} plant(s), {RepositoryStatus.CollectionJobs} collection job(s) and {RepositoryStatus.Readings} reading(s).")</p>
                </div>
                <span class="status-pill @(RepositoryStatus?.Connected == true ? "status-successful" : "status-failed")">@(RepositoryStatus?.Connected == true ? "Healthy" : "Unavailable")</span>
            </div>
            <div class="health-status-details">
                <div><span>Application</span><strong>Blazor Server</strong></div>
                <div><span>Backend</span><strong>Authorised application service</strong></div>
                <div><span>Database</span><strong>@(RepositoryStatus?.Database ?? "Configured database")</strong></div>
                <div><span>Connection</span><strong>@(RepositoryStatus is null ? "Not confirmed" : RepositoryStatus.Connected ? "Online" : "Unavailable")</strong></div>
            </div>
            <div class="metric-dialog-footer health-status-footer">
                <span>Status confirmed when this dashboard was loaded.</span>
                <button class="primary-action" type="button" @onclick="CloseHealthStatus">Close</button>
            </div>
        </section>
    </div>
}

@if (IsMetricOpen)
{
    <div class="metric-modal-overlay" role="presentation">
        <section class="metric-dialog" role="dialog" aria-modal="true" aria-labelledby="metric-dialog-title">
            <div class="metric-dialog-header">
                <div>
                    <p class="section-label">Dashboard details</p>
                    <h2 id="metric-dialog-title">@SelectedMetricTitle</h2>
                    <p>@SelectedMetricDescription</p>
                </div>
                <button class="profile-close" type="button" @onclick="CloseMetric" aria-label="Close list">×</button>
            </div>

            <div class="metric-dialog-summary">
                <span class="summary-mark">@SelectedMetricCode</span>
                <div>
                    <strong>@SelectedMetricItems.Count</strong>
                    <small>Total matching item(s)</small>
                </div>
            </div>

            <div class="metric-detail-list">
                @for (var index = 0; index < SelectedMetricItems.Count; index++)
                {
                    var item = SelectedMetricItems[index];
                    <article class="metric-detail-item">
                        <span class="metric-item-number">@((index + 1).ToString("00"))</span>
                        <div class="metric-item-name">
                            <strong>@item.Name</strong>
                            <small>@item.Description</small>
                        </div>
                        <div class="metric-item-reference">
                            <strong>@item.Reference</strong>
                            <small>@item.UpdatedAt.ToString("dd MMM yyyy")</small>
                        </div>
                        <span class="status-pill status-@item.Status.ToLowerInvariant()">@item.Status</span>
                    </article>
                }
            </div>

            <div class="metric-dialog-footer">
                <span>Data retrieved from the SBLSS repository.</span>
                <button class="primary-action" type="button" @onclick="CloseMetric">Close <span>×</span></button>
            </div>
        </section>
    </div>
}
