@page "/admin/data-quality"
@attribute [Authorize(Roles = "SuperAdministrator,Administrator")]
@rendermode InteractiveServer
@using TestingSystem.Web.Services
<PageTitle>Data Quality | SBLSS System</PageTitle>

<div class="admin-page data-quality-page">
 <header class="page-heading">
  <div><p class="section-label">Report validation management</p><h1>Data Quality Rules</h1><p class="page-subtitle">Create and manage DDQ/MMF validation and substitution rules applied when reports are prepared; collected database values remain unchanged.</p></div>
  <div class="system-managed-badge"><span>&#10003;</span><div><strong>Report validation active</strong><small>Database values remain unchanged</small></div></div>
 </header>
 @if (Notice is not null) { <div class="quality-notice"><span>&#10003;</span>@Notice<button type="button" @onclick="() => Notice = null">&#215;</button></div> }
 <section class="admin-summary"><div><small>Total rules</small><strong>@Rules.Count</strong></div><div><small>Fixed structural</small><strong>@FixedRules.Count</strong></div><div><small>Admin-created</small><strong>@ConfiguredRules.Count</strong></div><div><small>Active rules</small><strong>@Rules.Count(x => x.IsActive)</strong></div></section>

 <section class="table-panel quality-rule-panel">
  <div class="admin-table-heading quality-panel-heading">
   <div><p class="section-label">Validation and substitution policy</p><h2>@SelectedApiType rules</h2><p class="quality-report-only-copy">Fixed and administrator-configured rules are shown together with the action used in generated reports.</p></div>
   <button class="quality-create-button" type="button" @onclick="CreateRule"><span>+</span> Create configured rule</button>
  </div>
  <div class="quality-rule-toolbar">
   <div class="api-type-switch">@foreach (var type in new[] { "DDQ", "MMF" }) { <button type="button" class="@(SelectedApiType == type ? "active" : null)" @onclick="() => SelectApiType(type)">@type <small>@Rules.Count(x => x.DataType == type)</small></button> }</div>
   <span class="quality-report-only-title">Applied during report generation</span>
  </div>
  <div class="quality-combined-scroll">
   <div class="quality-combined-row quality-combined-header"><span>Rule</span><span>Validation condition</span><span>Report substitution / action</span><span>Severity</span><span>Status / actions</span></div>
   @if (VisibleRules.Count == 0) { <div class="collection-empty"><strong>No @SelectedApiType rules</strong><span>Create a configured rule to validate report data.</span></div> }
   @foreach (var rule in TablePaging.Slice(VisibleRules, RulePage))
   {
    <article class="quality-combined-row @(rule.IsActive ? null : "is-inactive")">
     <div class="quality-rule-copy"><span class="quality-rule-origin @(!IsFixed(rule) ? "configured" : "fixed")">@SourceLabel(rule)</span><strong>@rule.Code · @rule.Name</strong><small>@(rule.FieldName == "*" ? "All parameters" : rule.FieldName)</small></div>
     <div class="quality-rule-condition"><strong>@rule.Condition</strong><small>@rule.Description</small></div>
     <div class="quality-substitution-copy">@SubstitutionFor(rule)</div>
     <span class="quality-severity severity-@rule.Severity.ToLowerInvariant()">@rule.Severity</span>
     <div class="quality-rule-actions"><button class="quality-toggle @(rule.IsActive ? "active" : null)" type="button" @onclick="() => ToggleRuleAsync(rule)"><i></i><span>@(rule.IsActive ? "Active" : "Inactive")</span></button>@if (CanEdit(rule)) { <button class="quality-icon-action" type="button" @onclick="() => EditRule(rule)">Edit</button> }@if (CanDelete(rule)) { <button class="quality-icon-action delete" type="button" @onclick="() => DeleteTarget = rule">Delete</button> }</div>
    </article>
   }
  </div>
  <TablePagination TotalItems="@VisibleRules.Count" @bind-Page="RulePage" />
  <div class="quality-policy-note"><span>i</span><p><strong>Collection and reporting flow</strong>The API response and translated readings are saved as received. Fixed structural rules protect duplicate keys, timestamps and formats. For MMF, parameter names are detected from API readings; administrators create rules for those parameters and configure their own minimum, maximum and change-rate limits.</p></div>
 </section>
</div>
@if (EditorOpen)
{
 <div class="quality-modal-overlay"><section class="quality-rule-modal" role="dialog" aria-modal="true">
  <header><div><p class="section-label">Configurable validation</p><h2>@(Editor.Id.HasValue ? "Edit rule" : "Create rule")</h2></div><button type="button" @onclick="() => EditorOpen = false">&#215;</button></header>
  <div class="quality-rule-form">
   @if (FormError is not null) { <div class="quality-form-error">@FormError</div> }
   <div class="quality-form-grid">
    <label><span>Rule name *</span><input maxlength="200" @bind="Editor.Name" placeholder="Example: GHI operating limits" /></label>
    <label><span>API type *</span><select @bind="Editor.DataType"><option>DDQ</option><option>MMF</option></select></label>
    <label><span>Field / parameter *</span><input maxlength="100" @bind="Editor.FieldName" list="detected-mmf-parameters" placeholder="Choose or type a parameter" /><datalist id="detected-mmf-parameters">@foreach (var parameter in DetectedMmfParameters) { <option value="@parameter"></option> }</datalist><small>@(Editor.DataType == "MMF" ? DetectedMmfParameters.Count == 0 ? "No MMF parameters detected yet; you can still type the API parameter name." : "Detected from MMF API readings. Choose a parameter or type its exact API name." : "Use the API field name, or * for all fields.")</small></label>
   </div>
   <label class="quality-description"><span>Description</span><textarea maxlength="1000" rows="2" @bind="Editor.Description"></textarea></label>
   <fieldset class="quality-check-builder"><legend>Checks to apply</legend>
    <label class="quality-check-row"><input type="checkbox" @bind="Editor.UseMinimum" /><span><strong>Minimum threshold</strong><small>Flag values below this number.</small></span><input type="number" step="any" disabled="@(!Editor.UseMinimum)" @bind="Editor.MinimumValue" placeholder="Min" /></label>
    <label class="quality-check-row"><input type="checkbox" @bind="Editor.UseMaximum" /><span><strong>Maximum threshold</strong><small>Flag values above this number.</small></span><input type="number" step="any" disabled="@(!Editor.UseMaximum)" @bind="Editor.MaximumValue" placeholder="Max" /></label>
    <label class="quality-check-row"><input type="checkbox" @bind="Editor.UseChange" /><span><strong>Changing value / hysteresis</strong><small>Flag changes above this limit.</small></span><input type="number" min="0" step="any" disabled="@(!Editor.UseChange)" @bind="Editor.ChangeThreshold" placeholder="Change" /></label>
    <label class="quality-check-row missing"><input type="checkbox" @bind="Editor.CheckMissing" /><span><strong>Missing / null data</strong><small>Flag missing parameters and interval gaps.</small></span></label>
   </fieldset>
   <label class="quality-active-choice"><input type="checkbox" @bind="Editor.IsActive" /><span><strong>Activate this rule</strong><small>Apply it when the next matching report is generated.</small></span></label>
  </div>
  <footer><button class="quality-secondary-button" type="button" disabled="@SavingRule" @onclick="() => EditorOpen = false">Cancel</button><button class="quality-primary-button" type="button" disabled="@SavingRule" @onclick="SaveRuleAsync">@(SavingRule ? "Saving…" : "Save rule")</button></footer>
 </section></div>
}

@if (DeleteTarget is not null)
{
 <div class="quality-modal-overlay"><section class="quality-delete-modal" role="alertdialog" aria-modal="true"><span class="quality-delete-icon">!</span><div><p class="section-label">Delete configured rule</p><h2>Delete @DeleteTarget.Code?</h2><p>The rule “@DeleteTarget.Name” will no longer be applied to newly generated reports.</p></div><footer><button class="quality-secondary-button" type="button" @onclick="() => DeleteTarget = null">Keep rule</button><button class="quality-delete-button" type="button" @onclick="DeleteRuleAsync">Confirm delete</button></footer></section></div>
}
