@page "/mmf-analytics"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject TestingSystem.Web.Backend.UseCases.UCLSS027Audit.IAuditTrailService AuditTrail
@using TestingSystem.Web.Services

<PageTitle>Meteorological Measuring Facility Analytics | SBLSS System</PageTitle>

<div class="mmf-page">
    <header class="page-heading">
        <div>
            <p class="section-label">Weather data monitoring</p>
            <h1>Meteorological Measuring Facility (MMF) Analytics</h1>
            <p class="page-subtitle">Analyse meteorological measurements from LSS plants by parameter, interval, location and forecast period.</p>
        </div>
        <span class="mmf-badge"><span></span> Live meteorological data</span>
    </header>

    <section class="filter-panel mmf-filter-panel" aria-labelledby="mmf-filter-heading">
        <div class="filter-panel-heading">
            <div>
                <p class="section-label">Step 1 · Query controls</p>
                <h2 id="mmf-filter-heading">Meteorological Data Filter</h2>
            </div>
        </div>

        <form @onsubmit="ApplyFilters" @onsubmit:preventDefault>
            <div class="compact-filter-layout mmf-compact-filter">
                <div class="filter-section location-section">
                    <div class="filter-section-heading"><span>1</span><div><strong>Plant or location</strong><small>Leave empty for all active plants.</small></div></div>
                    <div class="location-selector-stack">
                        <section class="location-selector-card @(SelectedPlantIds.Count > 0 ? "selected" : null) @(PlantFilterDisabled ? "disabled" : null)">
                            <div class="location-selector-heading"><span class="location-selector-number">A</span><div><strong>Plant</strong><small>Select one or more individual LSS plants.</small></div></div>
                            <PlantFilter @key="FilterVersion" Plants="RegisteredPlants" SelectedIds="SelectedPlantIds"
                                         SelectedIdsChanged="OnPlantsChanged" Disabled="PlantFilterDisabled" />
                        </section>
                        <section class="location-selector-card @(SelectedStates.Count > 0 ? "selected" : null) @(StateFilterDisabled ? "disabled" : null)">
                            <div class="location-selector-heading"><span class="location-selector-number">B</span><div><strong>States</strong><small>Each selected state produces its own plant average.</small></div></div>
                            <StringMultiFilter Label="States" Items="AvailableStates" SelectedValues="SelectedStates"
                                               SelectedValuesChanged="OnStatesChanged" Disabled="StateFilterDisabled" />
                        </section>
                        <section class="location-selector-card @(SelectedRegions.Count > 0 ? "selected" : null) @(RegionFilterDisabled ? "disabled" : null)">
                            <div class="location-selector-heading"><span class="location-selector-number">C</span><div><strong>Regions</strong><small>Each selected region produces its own plant average.</small></div></div>
                            <StringMultiFilter Label="Regions" Items="AvailableRegions" SelectedValues="SelectedRegions"
                                               SelectedValuesChanged="OnRegionsChanged" Disabled="RegionFilterDisabled" />
                        </section>
                    </div>
                </div>
                <div class="compact-filter-right">
                    <div class="filter-section parameter-section">
                        <div class="filter-section-heading"><span>2</span><div><strong>Parameter and interval</strong><small>Leave parameters empty to include all.</small></div></div>
                        <ParameterFilter @key="ParameterFilterVersion" Parameters="AvailableParameters" @bind-SelectedValues="SelectedParameters" />
                        <label class="filter-field interval-control"><span>Data interval</span><select @bind="SelectedInterval">
                            @foreach (var interval in Intervals) { <option value="@interval.Value">@interval.Label</option> }
                        </select></label>
                    </div>
                    <div class="filter-section period-section">
                        <div class="filter-section-heading"><span>3</span><div><strong>Forecast data range</strong><small>Select the start and end date and time.</small></div></div>
                        <div class="date-pair">
                            <div class="date-time-control"><span>Start</span><div><label><small>Date</small><span class="sblss-picker"><span class="sblss-picker-copy"><b>@StartDate.ToString("dd/MM/yyyy")</b><small>day/month/year</small></span><span class="sblss-picker-icon" aria-hidden="true">▣</span><input class="sblss-picker-native" aria-label="Start date in day month year format" type="date" required @bind="StartDate" @bind:format="yyyy-MM-dd" /></span></label><label><small>Time</small><span class="sblss-picker sblss-picker-time"><span class="sblss-picker-copy"><b>@TimeDisplay.TwentyFourHour(StartTime)</b><small>24-hour time</small></span><span class="sblss-picker-icon sblss-clock-icon" aria-hidden="true">◷</span><input class="sblss-picker-native" aria-label="Start time in 24 hour format" type="time" required step="900" @bind="StartTime" /></span></label></div></div>
                            <div class="date-time-control"><span>End</span><div><label><small>Date</small><span class="sblss-picker"><span class="sblss-picker-copy"><b>@EndDate.ToString("dd/MM/yyyy")</b><small>day/month/year</small></span><span class="sblss-picker-icon" aria-hidden="true">▣</span><input class="sblss-picker-native" aria-label="End date in day month year format" type="date" required @bind="EndDate" @bind:format="yyyy-MM-dd" /></span></label><label><small>Time</small><span class="sblss-picker sblss-picker-time"><span class="sblss-picker-copy"><b>@TimeDisplay.TwentyFourHour(EndTime)</b><small>24-hour time</small></span><span class="sblss-picker-icon sblss-clock-icon" aria-hidden="true">◷</span><input class="sblss-picker-native" aria-label="End time in 24 hour format" type="time" required step="900" @bind="EndTime" /></span></label></div></div>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ValidationMessage))
            {
                <p class="filter-error" role="alert">@ValidationMessage</p>
            }

            <div class="filter-actions">
                <span>Apply the filter to find available MMF datasets.</span>
                <div class="filter-action-buttons"><button class="filter-reset" type="button" disabled="@IsLoading" @onclick="ResetFilters">Reset</button><button class="primary-action mmf-primary-action" type="submit" disabled="@IsLoading">@(IsLoading ? "Loading..." : "Apply Filter") <span>→</span></button></div>
            </div>
        </form>
    </section>

    @if (HasApplied)
    {
        <section class="filter-summary mmf-summary" aria-live="polite"><span class="summary-mark">MMF</span><div><strong>Filtered MMF data</strong><p>@ResultDescription</p></div></section>
        <section class="table-panel mmf-template-panel">
            <div class="ddq-table-heading">
                <div><p class="section-label">Step 2 · Results</p><h2>@(IsLocationAverage ? $"{AppliedScope} averages" : "Plant time data")</h2><p>@(IsLocationAverage ? $"Each row is calculated separately from the LSS plants within its selected {AppliedScope.ToLowerInvariant()}." : "LSS codes run vertically; selected data intervals run horizontally as HR1, HR2 and onward.")</p></div>
                <div class="result-heading-actions"><span class="result-count">@ReadingIndex.Count reading(s)</span>
                    @if (LoadedReadings.Count > 0) { <button type="button" class="result-download excel" disabled="@IsExporting" @onclick="DownloadExcelAsync">@(IsExporting ? "Preparing Excel..." : "↓ Download Excel")</button> }
                </div>
            </div>
            @if (LoadedReadings.Count > 0)
            {
                <div class="result-view-switch" role="group"><button type="button" class="@(DisplayMode == "table" ? "active" : null)" @onclick='() => SetDisplayMode("table")'>▦ Table View</button><button type="button" class="@(DisplayMode == "graph" ? "active" : null)" @onclick='() => SetDisplayMode("graph")'>⌁ Graph View</button></div>
                <div class="data-type-tabs" role="tablist" aria-label="Selected MMF parameters">
                    @foreach (var parameter in AppliedParameters) { <button type="button" role="tab" aria-selected="@(ActiveParameter == parameter)" class="@(ActiveParameter == parameter ? "active" : null)" @onclick="() => SelectParameter(parameter)">@parameter</button> }
                </div>
                <div class="excel-sheet-heading mmf-sheet-heading"><div class="excel-sheet-title">@ActiveParameter.ToUpperInvariant()</div><div class="excel-sheet-meta"><span><small>Parameter</small><strong>@ActiveParameter</strong></span><span><small>Submission date &amp; time</small><strong>@SubmissionDateTimeRange</strong></span><span><small>Data interval</small><strong>@IntervalLabel</strong></span><span><small>Data timestamp range</small><strong>@TimeDisplay.DateTime(AppliedStart) - @TimeDisplay.DateTime(AppliedEnd)</strong></span><span><small>Unit</small><strong>@UnitForParameter</strong></span></div></div>
                @if (DisplayMode == "table")
                {
                    <div class="mmf-pivot-scroll"><table class="mmf-pivot-table"><thead><tr><th class="sticky-plant">@ScopeColumnHeading</th>@for (var index = 0; index < TimeColumns.Count; index++) { <th title="@TimeHeading(TimeColumns[index])">@HourHeading(index)</th> }</tr></thead><tbody>
                    @foreach (var plant in ResultPlants) { <tr><th class="sticky-plant" title="@($"{plant.Name} · {plant.PlantId}")">@ResultRowLabel(plant)</th>@foreach (var time in TimeColumns) { var value=ValueFor(plant.Id,time); <td class="@(value.HasValue ? null : "missing-cell")" title="@TimeHeading(time)">@(value?.ToString("N2") ?? "-")</td> }</tr> }
                    </tbody></table></div>
                }
                else
                {
                    <div class="graph-panel mmf-template-graph">
                    <div class="graph-heading"><div><strong>@ActiveParameter profile</strong><small>Date/time versus @UnitForParameter</small></div><div class="graph-metrics"><span><b>@VisibleGraphPlantCount</b> visible @(IsLocationAverage ? "average series" : "plant(s)")</span><span><b>@GraphMinimum.ToString(GraphTickFormat)–@GraphMaximum.ToString(GraphTickFormat) @UnitForParameter</b> scale</span><span><b>@TimeColumns.Count</b> intervals</span></div></div>
                    <div class="graph-help"><span>ⓘ</span> Hover over a line to see the plant, timestamp and averaged value. Use the legend below to show or hide lines.</div>
                    <div class="graph-scroll"><svg class="ddq-line-chart" viewBox="0 0 1100 420" role="img" aria-label="@($"{ActiveParameter} by plant and date time")">
                    <defs><linearGradient id="mmfChartBackground" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#f4fbf7"/><stop offset="100%" stop-color="#ffffff"/></linearGradient><filter id="mmfLineGlow" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="1.2" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>
                    <rect x="74" y="24" width="990" height="340" class="mmf-chart-plot-bg" />
                    @foreach (var tick in GraphYTicks())
                    {
                        <line class="chart-grid-line" x1="74" y1="@tick.Y" x2="1064" y2="@tick.Y" />
                        <svg:text x="64" y="@(tick.Y + 4)" text-anchor="end" class="chart-axis-label">@tick.Value.ToString(GraphTickFormat)</svg:text>
                    }
                    @foreach (var tick in GraphXTicks())
                    {
                        <line class="chart-grid-line vertical" x1="@tick.X" y1="24" x2="@tick.X" y2="364" />
                        <svg:text x="@tick.X" y="386" text-anchor="middle" class="chart-axis-label">@tick.Value.ToString("dd MMM HH:mm")</svg:text>
                    }
                    <svg:text x="18" y="194" transform="rotate(-90 18 194)" text-anchor="middle" class="chart-axis-title">@UnitForParameter</svg:text>
                    <svg:text x="569" y="412" text-anchor="middle" class="chart-axis-title">Date and time</svg:text>
                    @foreach (var plant in ResultPlants.Where(x => !HiddenGraphPlantIds.Contains(x.Id)))
                    {
                        <polyline fill="none" stroke="@GraphColour(plant)" class="plant-series mmf-plant-series" points="@GraphPoints(plant)"><title>@plant.Name (@plant.PlantId)</title></polyline>
                        @foreach (var point in GraphPointItems(plant))
                        {
                            <g class="chart-hover-target">
                                @if (ShowGraphCrosshair) { <line x1="@point.X" y1="24" x2="@point.X" y2="364" class="chart-crosshair"/><line x1="74" y1="@point.Y" x2="1064" y2="@point.Y" class="chart-crosshair"/> }
                                <circle cx="@point.X" cy="@point.Y" r="7" fill="transparent" class="plant-data-hit" stroke="@GraphColour(plant)"><title>@plant.Name (@plant.PlantId)&#10;@point.Timestamp.ToString("dd MMM yyyy, HH:mm")&#10;@ActiveParameter: @point.Value.ToString("N2") @UnitForParameter</title></circle>
                            </g>
                        }
                    }
                    </svg></div>
                    <div class="graph-legend-section"><div class="graph-legend-title"><div><strong>@(IsLocationAverage ? "Location average legend" : "Plant legend")</strong><small>@FilteredLegendPlants.Count() of @ResultPlants.Count series</small></div><div class="graph-legend-tools"><label class="legend-search"><span aria-hidden="true">⌕</span><input type="search" placeholder="Search plant, location or ID" @bind="LegendSearch" @bind:event="oninput" /></label><button type="button" class="legend-tool" @onclick="ShowAllGraphPlants">Show all</button><button type="button" class="legend-tool" @onclick="HideAllGraphPlants">Hide all</button><button type="button" class="crosshair-toggle @(ShowGraphCrosshair ? "active" : null)" aria-pressed="@ShowGraphCrosshair" @onclick="ToggleGraphCrosshair"><span aria-hidden="true">⌖</span> Crosshair @(ShowGraphCrosshair ? "On" : "Off")</button></div></div>
                    <div class="graph-legend" aria-label="Plant line visibility">@foreach (var plant in FilteredLegendPlants) { var hidden=HiddenGraphPlantIds.Contains(plant.Id); <button type="button" class="@(hidden ? "hidden" : null)" aria-pressed="@(!hidden)" @onclick="() => ToggleGraphPlant(plant.Id)"><i style="background:@GraphColour(plant)"></i><span><b>@plant.Name</b><small>@plant.PlantId</small></span><em>@(hidden ? "○" : "✓")</em></button> }</div>
                    @if (!FilteredLegendPlants.Any()) { <p class="legend-empty">No plant matches “@LegendSearch”.</p> }
                    </div></div>
                }
            }
            else { <p class="analytics-empty">No MMF data is available for this filter.</p> }
        </section>
    }
</div>
