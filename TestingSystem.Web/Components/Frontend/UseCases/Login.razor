@page "/login"
@attribute [AllowAnonymous]
@layout TestingSystem.Web.Components.Layout.LoginLayout

<PageTitle>Sign in | Single Buyer LSS Repository</PageTitle>

<div class="login-page">
    <section class="login-story">
        <div class="brand-lockup brand-lockup-light">
            <img class="brand-logo" src="single-buyer-logo.png" alt="Single Buyer" />
            <span>
                <small>Large Scale Solar Repository</small>
            </span>
        </div>

        <div class="story-copy">
            <p class="section-label section-label-light">Secure energy information</p>
            <h1>SINGLE BUYER LARGE SCALE SOLAR REPOSITORY</h1>
        </div>

        <div class="energy-orbit" aria-hidden="true">
            <span class="orbit-sun"></span>
            <span class="orbit-line orbit-line-one"></span>
            <span class="orbit-line orbit-line-two"></span>
            <span class="orbit-grid"></span>
        </div>
    </section>

    <section class="login-panel">
        <div class="login-card">
            <div class="mobile-brand">
                <img class="brand-logo" src="single-buyer-logo.png" alt="Single Buyer" />
            </div>

            <div class="login-access-card">
                <div class="identity-provider">
                    <span class="local-login-mark" aria-hidden="true">L</span>
                    <span>
                        <small>Secured by</small>
                        <strong>WEBGSO local account</strong>
                    </span>
                </div>

                <p class="section-label">Authorised access</p>
                <h2>Welcome back</h2>
                <p class="login-intro">Enter your username or email and password to access the LSS repository.</p>

                @if (Reason == "session-timeout")
                {
                    <div class="login-alert login-timeout-alert" role="status">
                        Your session ended after 15 minutes of inactivity. Sign in once to continue.
                    </div>
                }

                @if (Registered == "pending")
                {
                    <div class="login-alert login-success-alert" role="status">
                        Account created. A Super Admin must approve it before you can sign in.
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Error))
                {
                    <div class="login-alert" role="alert">
                        @(Error switch
                        {
                            "access-pending" => "Your account is waiting for administrator approval.",
                            "access-rejected" => "Your access request was not approved. Contact the system administrator.",
                            "access-inactive" => "This account is inactive. Contact the system administrator to restore access.",
                            "locked" => "This account is temporarily locked after repeated unsuccessful attempts. Try again later.",
                            _ => "The username/email or password is incorrect."
                        })
                    </div>
                }

                <form method="post" action="/account/login" class="login-form">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />
                    <label for="login-identifier">Username or email</label>
                    <div class="input-shell">
                        <span aria-hidden="true">ID</span>
                        <input id="login-identifier" name="identifier" type="text" autocomplete="username" required />
                    </div>
                    <label for="login-password">Password</label>
                    <div class="input-shell">
                        <span aria-hidden="true">PW</span>
                        <input id="login-password" name="password" type="password" autocomplete="current-password" required />
                    </div>
                    <button type="submit" class="login-button">
                        <span>Sign in</span>
                        <span class="login-arrow" aria-hidden="true">→</span>
                    </button>
                </form>

                <div class="first-access-note">
                    <span aria-hidden="true">i</span>
                    <p><strong>Need an account?</strong> <a href="/register">Create a local account</a>. A Super Admin will review your request.</p>
                </div>

                <aside class="login-disclaimer" role="note" aria-label="TNB information protection notice">
                    <span class="login-disclaimer-icon" aria-hidden="true">!</span>
                    <div>
                        <strong>Information protection notice</strong>
                        <p>This application contains TNB information. Any modification, copying, reproduction,
                            republication, uploading, posting, transmission or distribution of this information,
                            including any related text, graphics, code and/or software, without prior written
                            permission is prohibited.</p>
                    </div>
                </aside>

                <div class="security-note">
                    <span class="security-dot"></span>
                    Protected by password authentication and role-based access.
                </div>
            </div>
        </div>

        <SystemFooter LoginVariant="true" />
    </section>
</div>
