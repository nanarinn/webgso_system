@page "/login"
@attribute [AllowAnonymous]
@layout TestingSystem.Web.Components.Layout.LoginLayout
@inject IConfiguration Configuration

<PageTitle>Sign in | Single Buyer LSS Repository</PageTitle>

<div class="login-page">
    <section class="login-story">
        <div class="brand-lockup brand-lockup-light">
            <img class="brand-logo" src="single-buyer-logo.png" alt="Single Buyer" />
            <span>
                <small>Large Scale Solar Repository</small>
            </span>
        </div>

        <div class="story-copy">
            <p class="section-label section-label-light">Secure energy information</p>
            <h1>SINGLE BUYER LARGE SCALE SOLAR REPOSITORY</h1>
        </div>

        <div class="energy-orbit" aria-hidden="true">
            <span class="orbit-sun"></span>
            <span class="orbit-line orbit-line-one"></span>
            <span class="orbit-line orbit-line-two"></span>
            <span class="orbit-grid"></span>
        </div>
    </section>

    <section class="login-panel">
        <div class="login-card">
            <div class="mobile-brand">
                <img class="brand-logo" src="single-buyer-logo.png" alt="Single Buyer" />
            </div>

            <div class="login-access-card">
                <div class="identity-provider">
                    <span class="microsoft-mark" aria-hidden="true">
                        <i></i><i></i><i></i><i></i>
                    </span>
                    <span>
                        <small>Secured by</small>
                        <strong>Microsoft Entra ID</strong>
                    </span>
                </div>

                <p class="section-label">Authorised access</p>
                <h2>Welcome back</h2>
                <p class="login-intro">Use your assigned SAE Microsoft account to access the LSS repository.</p>

                @if (Reason == "session-timeout")
                {
                    <div class="login-alert login-timeout-alert" role="status">
                        Your session ended after 15 minutes of inactivity. Sign in once to continue.
                    </div>
                }

                @if (Error is "microsoft" or "microsoft-setup" or "microsoft-consent" or "microsoft-pending" or "microsoft-rejected" or "microsoft-inactive" or "microsoft-assignment" or "microsoft-redirect" or "microsoft-secret" or "access-pending" or "access-rejected" or "access-inactive")
                {
                    <div class="login-alert" role="alert">
                        @(Error switch
                        {
                            "microsoft-setup" => "Microsoft sign-in requires completed configuration and HTTPS.",
                            "microsoft-pending" or "access-pending" => "Your identity was verified. Your access request is waiting for administrator approval.",
                            "microsoft-rejected" or "access-rejected" => "Your access request was not approved. Contact the system administrator if you need assistance.",
                            "microsoft-inactive" or "access-inactive" => "This account is inactive. Contact the system administrator to restore access.",
                            "microsoft-assignment" => "This company account is not assigned to the SBLSS Enterprise Application. Ask the Entra administrator to add the user.",
                            "microsoft-redirect" => "The Microsoft redirect URI does not match the registered HTTPS /signin-oidc address.",
                            "microsoft-secret" => "The Microsoft App Registration secret is invalid or expired. Run the local Entra setup with a new Client Secret Value.",
                            "microsoft-consent" => "Microsoft permission consent was not completed. Ask your tenant administrator if approval is required.",
                            _ => "Microsoft sign-in was not completed. Ask your administrator to check the app assignment and configuration."
                        })
                    </div>
                }

                <form method="post" action="/account/microsoft" class="login-form">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />
                    <button type="submit" class="login-button"
                            disabled="@(!TestingSystem.Web.Connectors.UseCases.EntraAuthentication.IsReady(Configuration))">
                        <span class="button-microsoft-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                        <span>Continue with Microsoft</span>
                        <span class="login-arrow" aria-hidden="true">→</span>
                    </button>
                    @if (!TestingSystem.Web.Connectors.UseCases.EntraAuthentication.IsReady(Configuration))
                    {
                        <small class="login-setup-message">Microsoft sign-in needs the App Registration secret on this machine. Run <code>.\setup-entra-local.ps1</code> once.</small>
                    }
                </form>

                <div class="access-assurance" aria-label="Access protection">
                    <div>
                        <span class="assurance-icon">✓</span>
                        <span><strong>Company identity</strong><small>Verified SAE Microsoft account</small></span>
                    </div>
                    <div>
                        <span class="assurance-icon">✓</span>
                        <span><strong>Managed access</strong><small>Approved roles and permissions</small></span>
                    </div>
                </div>

                <div class="first-access-note">
                    <span aria-hidden="true">i</span>
                    <p><strong>First time signing in?</strong> Your verified account will be sent to an administrator for access approval.</p>
                </div>

                <div class="security-note">
                    <span class="security-dot"></span>
                    Protected by Microsoft Entra ID and role-based access.
                </div>
            </div>
        </div>

        <SystemFooter LoginVariant="true" />
    </section>
</div>
