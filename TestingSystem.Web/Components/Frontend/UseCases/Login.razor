@page "/login"
@attribute [AllowAnonymous]
@layout TestingSystem.Web.Components.Layout.LoginLayout
@inject IHostEnvironment Environment

<PageTitle>Sign in | Single Buyer LSS Repository</PageTitle>

<div class="login-page">
    <section class="login-story">
        <div class="brand-lockup brand-lockup-light">
            <img class="brand-logo" src="single-buyer-logo.png" alt="Single Buyer" />
            <span>
                <small>Large Scale Solar Repository</small>
            </span>
        </div>

        <div class="story-copy">
            <p class="section-label section-label-light">Secure energy information</p>
            <h1>SINGLE BUYER LARGE SCALE SOLAR REPOSITORY</h1>
        </div>

        <div class="energy-orbit" aria-hidden="true">
            <span class="orbit-sun"></span>
            <span class="orbit-line orbit-line-one"></span>
            <span class="orbit-line orbit-line-two"></span>
            <span class="orbit-grid"></span>
        </div>
    </section>

    <section class="login-panel">
        <div class="login-card">
            <div class="mobile-brand">
                <img class="brand-logo" src="single-buyer-logo.png" alt="Single Buyer" />
            </div>

            <p class="section-label">Authorised access</p>
            <h2>Welcome back</h2>
            <p class="login-intro">Sign in with your assigned repository account.</p>

            @if (Error == "invalid")
            {
                <div class="login-alert" role="alert">
                    Username or password is incorrect. Please try again.
                </div>
            }

            <form method="post" action="/account/login" class="login-form">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />

                <label for="username">Username</label>
                <div class="input-shell">
                    <span aria-hidden="true">ID</span>
                    <input id="username" name="username" type="text" autocomplete="username" required autofocus />
                </div>

                <label for="password">Password</label>
                <div class="input-shell">
                    <span aria-hidden="true">••</span>
                    <input id="password" name="password" type="password" autocomplete="current-password" required />
                </div>

                <button type="submit" class="login-button">
                    Sign in to repository
                    <span aria-hidden="true">→</span>
                </button>
            </form>

            @if (Environment.IsDevelopment())
            {
                <aside class="demo-accounts" aria-label="Development login accounts">
                    <div class="demo-heading">
                        <strong>Development accounts</strong>
                        <span>Local use only</span>
                    </div>
                    <div class="demo-account">
                        <span>Administrator</span>
                        <code>sb.admin</code>
                        <code>See local .env</code>
                    </div>
                    <div class="demo-account">
                        <span>Reviewer</span>
                        <code>sb.reviewer</code>
                        <code>See local .env</code>
                    </div>
                </aside>
            }

            <div class="security-note">
                <span class="security-dot"></span>
                Protected by encrypted authentication and role-based access.
            </div>
        </div>

        <SystemFooter LoginVariant="true" />
    </section>
</div>
