@page "/reports"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Report History | SBLSS System</PageTitle>

<div class="reports-page">
    <header class="page-heading">
        <div>
            <p class="section-label">Reporting centre</p>
            <h1>Report History</h1>
            <p class="page-subtitle">View the status and history of on-demand and scheduled reports.</p>
        </div>
        <span class="report-access-badge"><i></i> Staff &amp; Administrator access</span>
    </header>

    <section class="report-summary" aria-label="Report summary">
        <div><small>Total reports</small><strong>@ReportsList.Count</strong></div>
        <div><small>Completed</small><strong>@ReportsList.Count(report => report.Status == "Completed")</strong></div>
        <div><small>Processing</small><strong>@ReportsList.Count(report => report.Status == "Processing")</strong></div>
        <div><small>Anomalies found</small><strong>@ReportsList.Sum(report => report.AnomalyCount)</strong></div>
    </section>

    <section class="report-toolbar">
        <label class="report-search">
            <span aria-hidden="true">&#8981;</span>
            <input type="search" placeholder="Search report name, ID, source or requester..."
                   @bind="SearchTerm" @bind:event="oninput" />
        </label>
        <label class="report-filter">
            <span>Status</span>
            <select @bind="StatusFilter">
                <option value="All">All statuses</option>
                <option value="Completed">Completed</option>
                <option value="Processing">Processing</option>
                <option value="Failed">Failed</option>
            </select>
        </label>
        <label class="report-filter">
            <span>Report type</span>
            <select @bind="TypeFilter">
                <option value="All">All types</option>
                <option value="On-Demand">On-Demand</option>
                <option value="Scheduled">Scheduled</option>
            </select>
        </label>
        <span class="result-count">@FilteredReports.Count record(s)</span>
    </section>

    <section class="table-panel report-panel">
        <div class="report-table-heading">
            <div>
                <p class="section-label">Generated report files</p>
                <h2>Report status &amp; history</h2>
            </div>
            <span>Latest activity shown first</span>
        </div>

        <div class="report-table" role="table" aria-label="Report status and history">
            <div class="report-row report-header" role="row">
                <span>Report</span><span>Type</span><span>Generated</span><span>Status</span>
                <span>View</span><span>Main report</span><span>Anomaly report</span>
            </div>
            @if (FilteredReports.Count == 0)
            {
                <div class="report-empty"><strong>No report found</strong><span>Try another search or filter selection.</span></div>
            }
            else
            {
                @foreach (var report in FilteredReports)
                {
                    <div class="report-row" role="row">
                        <div class="report-name">
                            <span>@report.Source</span>
                            <div><strong>@report.Name</strong><small>@report.ReportId · Requested by @report.RequestedBy</small></div>
                        </div>
                        <span><span class="report-type type-@GetCssValue(report.Type)">@report.Type</span></span>
                        <time datetime="@report.GeneratedAt.ToString("O")">@report.GeneratedAt.ToString("dd MMM yyyy")<small>@report.GeneratedAt.ToString("HH:mm:ss")</small></time>
                        <span><span class="status-pill report-status-@report.Status.ToLowerInvariant()">@report.Status</span></span>
                        <button class="table-action report-view-action" type="button" @onclick="() => ViewReport(report)">View</button>
                        @if (report.Status == "Completed")
                        {
                            <a class="table-action main-download" href="@GetMainReportDataUri(report)" download="@GetMainFileName(report)">Download</a>
                            <a class="table-action anomaly-download" href="@GetAnomalyReportDataUri(report)" download="@GetAnomalyFileName(report)">
                                Anomaly (@report.AnomalyCount)
                            </a>
                        }
                        else
                        {
                            <span class="report-unavailable">Not ready</span><span class="report-unavailable">Not ready</span>
                        }
                    </div>
                }
            }
        </div>
    </section>

    @if (SelectedReport is not null)
    {
        <div class="report-overlay" role="presentation">
            <section class="report-dialog" role="dialog" aria-modal="true" aria-labelledby="report-detail-title">
                <div class="report-dialog-header">
                    <div><p class="section-label">Report details</p><h2 id="report-detail-title">@SelectedReport.Name</h2></div>
                    <button class="profile-close" type="button" @onclick="CloseReport" aria-label="Close report details">&#215;</button>
                </div>
                <div class="report-dialog-body">
                    <div class="report-detail-banner">
                        <span>@SelectedReport.Source</span>
                        <div><strong>@SelectedReport.Status</strong><small>@SelectedReport.ReportId</small></div>
                        <span class="report-type type-@GetCssValue(SelectedReport.Type)">@SelectedReport.Type</span>
                    </div>

                    <dl class="report-detail-grid">
                        <div><dt>Requested by</dt><dd>@SelectedReport.RequestedBy</dd></div>
                        <div><dt>Submission date</dt><dd>@SelectedReport.SubmissionDate.ToString("dd MMM yyyy")</dd></div>
                        <div><dt>Generated at</dt><dd>@SelectedReport.GeneratedAt.ToString("dd MMM yyyy, HH:mm:ss")</dd></div>
                        <div><dt>Anomalies found</dt><dd>@SelectedReport.AnomalyCount</dd></div>
                        <div class="report-description"><dt>Description</dt><dd>@SelectedReport.Description</dd></div>
                    </dl>

                    <section class="report-timeline">
                        <h3>Status history</h3>
                        @foreach (var item in GetStatusHistory(SelectedReport))
                        {
                            <div class="timeline-item @(item.IsCurrent ? "current" : null)">
                                <i></i><div><strong>@item.Label</strong><small>@item.Detail</small></div><time>@item.Time</time>
                            </div>
                        }
                    </section>

                    <div class="report-dialog-actions">
                        <button class="profile-cancel" type="button" @onclick="CloseReport">Close</button>
                        @if (SelectedReport.Status == "Completed")
                        {
                            <a class="table-action main-download" href="@GetMainReportDataUri(SelectedReport)" download="@GetMainFileName(SelectedReport)">Download Main Report</a>
                            <a class="table-action anomaly-download" href="@GetAnomalyReportDataUri(SelectedReport)" download="@GetAnomalyFileName(SelectedReport)">Download Anomaly Report</a>
                        }
                    </div>
                </div>
            </section>
        </div>
    }
</div>
