@page "/admin/lss-plants"
@attribute [Authorize(Roles = "SuperAdministrator,Administrator")]
@rendermode InteractiveServer

<PageTitle>LSS Plant Configuration | SBLSS System</PageTitle>

<div class="admin-page">
    <header class="page-heading">
        <div><p class="section-label">Administration</p><h1>LSS Plant Configuration</h1><p class="page-subtitle">Manage configured plants and their DDQ/MMF integration endpoints.</p></div>
        <div class="admin-header-actions">
            <button class="test-api-action" type="button" @onclick="OpenApiTestDialog">Test API</button>
            <button class="primary-action admin-primary" type="button" @onclick="OpenAddDialog">+ Add Plant</button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="admin-overlay success-overlay">
            <section class="configuration-success-dialog" role="dialog" aria-modal="true" aria-labelledby="configuration-success-title">
                <button class="profile-close" type="button" aria-label="Close success message" @onclick="() => SuccessMessage = string.Empty">&#215;</button>
                <span class="configuration-success-icon" aria-hidden="true">&#10003;</span>
                <p class="section-label">Configuration complete</p>
                <h2 id="configuration-success-title">@SuccessTitle</h2>
                <p>@SuccessMessage</p>
                <button class="primary-action admin-primary success-done" type="button" @onclick="() => SuccessMessage = string.Empty">Done</button>
            </section>
        </div>
    }
    <section class="admin-summary"><div><small>Total configured plants</small><strong>@Plants.Count</strong></div><div><small>Active plants</small><strong>@Plants.Count(x => x.IsActive)</strong></div><div><small>Inactive plants</small><strong>@Plants.Count(x => !x.IsActive)</strong></div></section>
    <section class="admin-toolbar"><label class="admin-search"><span>&#8981;</span><input type="search" placeholder="Search plant, state or Plant ID..." @bind="SearchTerm" @bind:event="oninput" /></label><span class="result-count">@FilteredPlants.Count plant(s)</span></section>
    <div class="api-type-switch" role="group" aria-label="Select API type">
        @foreach (var apiType in ApiTypes)
        {
            <button type="button" class="@(SelectedApiType == apiType ? "active" : null)" aria-pressed="@(SelectedApiType == apiType)" @onclick="() => SelectedApiType = apiType">
                <span class="api-switch-dot api-switch-@apiType.ToLowerInvariant()"></span>
                @apiType API
                <small>@FilteredApiConfigurations.Count(api => api.ApiType == apiType)</small>
            </button>
        }
    </div>

    @{ var configurations = FilteredApiConfigurations.Where(api => api.ApiType == SelectedApiType).ToList(); }
    <section class="table-panel admin-panel api-registry-panel">
        <div class="admin-table-heading"><div><p class="section-label">@SelectedApiType API registry</p><h2>@SelectedApiType API Configuration</h2></div><span>@configurations.Count endpoint(s) · Administrator access only</span></div>
        <div class="plant-admin-table"><div class="plant-admin-row admin-table-header"><span>Plant</span><span>State</span><span>Capacity</span><span>API Type</span><span>Data Type</span><span>API Link</span><span>Status</span><span>Action</span></div>
            @foreach (var api in TablePaging.Slice(configurations, PlantApiPage))
            {
                <div class="plant-admin-row"><div class="admin-entity"><span>@GetCode(api.Plant.Name)</span><div><strong>@api.Plant.Name</strong><small>@api.Plant.PlantId</small></div></div><span>@api.Plant.State</span><strong>@api.Plant.CapacityMw.ToString("N0") MW</strong><span class="api-type-badge api-type-@api.ApiType.ToLowerInvariant()">@api.ApiType</span><strong>@api.DataType</strong><code title="@api.ApiLink">@api.ApiLink</code><span class="status-pill @(api.Plant.IsActive ? "status-successful" : "status-failed")">@(api.Plant.IsActive ? "Active" : "Inactive")</span><button class="admin-edit-action" type="button" @onclick="() => OpenEditDialog(api.Plant, api.ApiType)">Edit</button></div>
            }
            @if (configurations.Count == 0)
            {
                <div class="api-registry-empty">No @SelectedApiType API configuration matches the current search.</div>
            }
        </div>
        <TablePagination TotalItems="@configurations.Count" @bind-Page="PlantApiPage" />
    </section>

    @if (IsDialogOpen)
    {
        <div class="admin-overlay"><section class="admin-dialog" role="dialog" aria-modal="true" aria-labelledby="plant-form-title"><div class="admin-dialog-header"><div><p class="section-label">@(EditingPlantId.HasValue ? "Update configuration" : "New configuration")</p><h2 id="plant-form-title">@(EditingPlantId.HasValue ? "Edit LSS plant" : "Add LSS plant")</h2></div><button class="profile-close" type="button" @onclick="CloseDialog">&#215;</button></div>
            <form @onsubmit="SavePlantAsync" @onsubmit:preventDefault>@if (!string.IsNullOrWhiteSpace(FormError)) { <div class="admin-alert error">@FormError</div> }<div class="admin-form-grid plant-details-grid"><label><span>Plant name</span><input required @bind="NewName" /></label><label><span>Plant ID</span><input required @bind="NewPlantId" /></label><label><span>State</span><select @bind="NewState">@foreach (var state in States){<option>@state</option>}</select></label><label><span>Capacity (MW)</span><input type="number" min="1" required @bind="NewCapacity" /></label><label class="wide"><span>API type</span><select @bind="NewApiType" @bind:after="ApiTypeChanged"><option value="DDQ">DDQ</option><option value="MMF">MMF</option></select></label></div><div class="api-config-heading"><div><strong>@NewApiType endpoint@(NewApiType == "DDQ" ? "s" : null)</strong><small>@(NewApiType == "DDQ" ? "Choose one unique data type for every API link." : "MMF supports one API link for each plant.")</small></div></div><div class="api-link-list">@foreach (var link in NewApiLinks){<div class="api-link-entry"><label><span>Data type</span><select @bind="link.DataType" disabled="@(NewApiType == "MMF")">@if(NewApiType == "DDQ"){@foreach(var type in AvailableDataTypes(link)){<option value="@type">@type</option>}}else{<option value="MMF">MMF</option>}</select></label><label><span>API link</span><input type="url" required placeholder="https://api.example.com/collection" @bind="link.ApiLink" /></label>@if(NewApiType == "DDQ"){<button type="button" title="Remove API link" disabled="@(NewApiLinks.Count == 1)" @onclick="() => RemoveApiLink(link)">&#215;</button>}</div>}@if(CanAddApiLink){<button class="add-api-link" type="button" @onclick="AddApiLink">+ Add another DDQ API link</button>}</div>@if(IsDeleteConfirmationOpen){<div class="schedule-confirm-overlay"><section class="schedule-status-confirmation delete-confirmation-dialog" role="alertdialog" aria-modal="true" aria-labelledby="plant-delete-title"><button class="profile-close" type="button" aria-label="Close confirmation" @onclick="HideDeleteConfirmation">&#215;</button><span class="schedule-status-warning">!</span><div><p class="section-label">Delete plant</p><h3 id="plant-delete-title">Delete this plant?</h3><p><b>@NewName</b> (@NewPlantId), its API configurations, collection schedules, collection history, readings and anomalies will be permanently removed.</p><div><button type="button" class="profile-cancel" @onclick="HideDeleteConfirmation">Keep Plant</button><button type="button" class="confirm-delete-action" @onclick="DeletePlantAsync">Confirm Delete</button></div></div></section></div>}<div class="profile-actions plant-form-actions">@if(EditingPlantId.HasValue && !IsDeleteConfirmationOpen){<button class="delete-plant-action" type="button" @onclick="ShowDeleteConfirmation">Delete Plant</button>}<span></span><button class="profile-cancel" type="button" @onclick="CloseDialog">Cancel</button><button class="primary-action admin-primary" type="submit" disabled="@IsDeleteConfirmationOpen">@(EditingPlantId.HasValue ? "Save Changes" : "Save Plant to MS SQL")</button></div></form>
        </section></div>
    }

    @if (IsApiTestDialogOpen)
    {
        <div class="admin-overlay">
            <section class="admin-dialog api-test-dialog" role="dialog" aria-modal="true" aria-labelledby="api-test-title">
                <div class="admin-dialog-header">
                    <div><p class="section-label">Connection verification</p><h2 id="api-test-title">Test Plant API</h2></div>
                    <button class="profile-close" type="button" @onclick="CloseApiTestDialog">&#215;</button>
                </div>
                <div class="api-test-form">
                    <p>Select a registered plant and endpoint. The latest URL and test result will be saved to MS SQL.</p>
                    <div class="admin-form-grid">
                        <label><span>LSS plant</span><select @bind="TestPlantId" @bind:after="LoadSelectedEndpoint">@foreach (var plant in Plants) { <option value="@plant.Id">@plant.Name</option> }</select></label>
                        <label><span>API type</span><select @bind="TestApiSource" @bind:after="LoadSelectedEndpoint"><option>DDQ</option><option>MMF</option></select></label>
                        <label class="wide"><span>API link</span><input type="url" required @bind="TestApiEndpoint" /></label>
                    </div>

                    @if (LastTestResult is not null)
                    {
                        <section class="api-test-result @(LastTestResult.IsConnected ? "connected" : "failed")">
                            <span>@(LastTestResult.IsConnected ? "OK" : "!")</span>
                            <div><strong>@(LastTestResult.IsConnected ? "API Connected" : "API Test Failed")</strong><p>@LastTestResult.Message</p><small>Response time: @LastTestResult.ElapsedMilliseconds ms</small></div>
                        </section>
                    }

                    <div class="profile-actions">
                        <button class="profile-cancel" type="button" @onclick="CloseApiTestDialog">@(LastTestResult is null ? "Cancel" : "Close")</button>
                        <button class="primary-action admin-primary" type="button" disabled="@IsTestingApi" @onclick="TestApiAsync">@(IsTestingApi ? "Testing connection..." : "Test Connection")</button>
                    </div>
                </div>
            </section>
        </div>
    }
</div>

@code { private int PlantApiPage { get; set; } = 1; }
