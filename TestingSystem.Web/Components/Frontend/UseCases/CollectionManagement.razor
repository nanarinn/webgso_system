@page "/repository"
@page "/collection-management"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Collection Management | Single Buyer LSS</PageTitle>

<div class="collection-page">
    <header class="page-heading">
        <div>
            <p class="section-label">API data operations</p>
            <h1>Collection Management</h1>
            <p class="page-subtitle">Monitor scheduled and manual DDQ/MMF API collection, response translation and database storage for every Large Scale Solar plant.</p>
        </div>
        <button class="primary-action collection-run-action" type="button" @onclick="OpenRunDialogAsync" disabled="@IsLoadingJobs">
            <span class="collection-run-icon">&#9654;</span> Run Manual
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(LoadErrorMessage))
    {
        <section class="collection-load-error" role="alert">
            <div><strong>Collection Management is temporarily unavailable</strong><span>@LoadErrorMessage</span></div>
            <button type="button" @onclick="RetryLoadAsync" disabled="@IsLoadingJobs">@(IsLoadingJobs ? "Loading..." : "Try again")</button>
        </section>
    }

    <section class="collection-toolbar">
        <label class="collection-search">
            <span aria-hidden="true">&#8981;</span>
            <input type="search" placeholder="Search plant, collection ID, mode or status..."
                   @bind="SearchTerm" @bind:event="oninput" />
        </label>
        <span class="result-count">@SelectedSectionBatches.Count collection run(s)</span>
    </section>

    <section class="table-panel collection-panel">
        <div class="collection-table-heading">
            <div>
                <p class="section-label">Plant API collection jobs</p>
                <h2>Collection history</h2>
            </div>
            <span>Grouped by collection time and selected plants</span>
        </div>

        <nav class="collection-section-tabs" aria-label="Collection data sections">
            @foreach (var tab in CollectionSectionTabs)
            {
                <button type="button"
                        class="collection-section-tab @(SelectedCollectionSectionKey == tab.Key ? "active" : string.Empty) collection-section-tab-@tab.ApiType.ToLowerInvariant()"
                        aria-pressed="@(SelectedCollectionSectionKey == tab.Key)"
                        @onclick="() => SelectCollectionSection(tab.Key)">
                    <span class="collection-section-tab-dot" aria-hidden="true"></span>
                    <span>@tab.Label</span>
                    <strong>@tab.Count</strong>
                </button>
            }
        </nav>

        @if (SelectedSectionBatches.Count == 0)
        {
            <div class="collection-empty">
                <strong>No @SelectedCollectionSectionLabel collection job found</strong>
                <span>Try a different search or select another section.</span>
            </div>
        }
        else
        {
            <div class="collection-table" role="table" aria-label="@SelectedCollectionSectionLabel collection history">
                <div class="collection-row collection-header" role="row">
                    <span>Collection run</span><span>API / data type</span><span>Total plants</span>
                    <span>Plant list</span><span>Result</span><span>Pull time</span>
                </div>
                @foreach (var batch in TablePaging.Slice(SelectedSectionBatches, CollectionPage))
                {
                    <div class="collection-row collection-batch-row" role="row">
                        <div class="collection-plant collection-run-identity">
                            <span>COL</span>
                            <div><strong>@batch.Mode</strong><small>@TimeDisplay.DateTimeLong(batch.SubmissionDate)</small></div>
                        </div>
                        <div class="collection-data-type">
                            <span class="api-type-badge api-type-@batch.ApiType.ToLowerInvariant()">@batch.ApiType</span>
                            <strong>@batch.DataType</strong>
                        </div>
                        <span class="collection-total-plants" title="@batch.PlantTitle">@(batch.PlantCount == 1 ? "1 plant" : $"{batch.PlantCount} plants")</span>
                        <div class="collection-plant-action-cell">
                            <button class="schedule-view-plants collection-view-plants" type="button" @onclick='() => OpenBatchSummary(batch, "All")'><span aria-hidden="true">&#9783;</span> View plants</button>
                        </div>
                        <div class="collection-batch-results">
                            <button type="button" class="batch-result-count batch-result-success" disabled="@(batch.SuccessfulCount == 0)"
                                    @onclick='() => OpenBatchSummary(batch, "Successful")'>
                                <span>Successful</span><strong>@batch.SuccessfulCount</strong>
                            </button>
                            <button type="button" class="batch-result-count batch-result-failed" disabled="@(batch.FailedCount == 0)"
                                    @onclick='() => OpenBatchSummary(batch, "Failed")'>
                                <span>Failed</span><strong>@batch.FailedCount</strong>
                            </button>
                            @if (batch.ProcessingCount > 0) { <small>@batch.ProcessingCount processing</small> }
                        </div>
                        <time datetime="@batch.RunAt.ToString("O")">@TimeDisplay.DateTimeWithSeconds(batch.RunAt)</time>
                    </div>
                }
            </div>
        }
        <TablePagination TotalItems="@SelectedSectionBatches.Count" @bind-Page="CollectionPage" />
    </section>

    @if (IsJobDetailOpen && SelectedJob is not null)
    {
        <div class="collection-overlay" role="presentation">
            <section class="collection-dialog collection-job-dialog" role="dialog" aria-modal="true" aria-labelledby="job-detail-title">
                <div class="collection-dialog-header">
                    <div>
                        <p class="section-label">Collection job details</p>
                        <h2 id="job-detail-title">@DisplayCollectionId(SelectedJob.CollectionId)</h2>
                    </div>
                    <button class="profile-close" type="button" @onclick="CloseJobDetail" aria-label="Close collection details">&#215;</button>
                </div>
                <div class="collection-dialog-body">
                    <div class="job-detail-lead">
                        <div class="collection-plant">
                            <span>@GetPlantCode(SelectedJob.PlantName)</span>
                            <div><strong>@SelectedJob.PlantName</strong><small>@SelectedJob.State, Malaysia</small></div>
                        </div>
                        <span class="status-pill status-@SelectedJob.Status.ToLowerInvariant()">@SelectedJob.Status</span>
                    </div>
                    <dl class="job-detail-grid">
                        <div><dt>API type</dt><dd>@SelectedJob.ApiType</dd></div>
                        <div><dt>Data type</dt><dd>@(string.IsNullOrWhiteSpace(SelectedJob.DataType) ? "General data" : SelectedJob.DataType)</dd></div>
                        <div><dt>Mode</dt><dd>@SelectedJob.Mode</dd></div>
                        <div><dt>Submission date &amp; time</dt><dd>@TimeDisplay.DateTimeLong(SelectedJob.SubmissionDate)</dd></div>
                        <div><dt>Run timestamp</dt><dd>@TimeDisplay.DateTimeWithSeconds(SelectedJob.RunAt)</dd></div>
                        <div><dt>Duration</dt><dd>@SelectedJob.DurationSeconds.ToString("0.00") seconds</dd></div>
                    </dl>
                    <section class="job-message @(SelectedJob.Status == "Failed" ? "job-message-failed" : "")">
                        <strong>@(SelectedJob.Status == "Failed" ? "Why this collection failed" : "Processing result")</strong>
                        <p>@(string.IsNullOrWhiteSpace(SelectedJob.ErrorMessage) ? SelectedJob.ResponseMessage : SelectedJob.ErrorMessage)</p>
                        @if (!string.IsNullOrWhiteSpace(SelectedJob.ResponseMessage) && SelectedJob.ResponseMessage != SelectedJob.ErrorMessage)
                        {
                            <small>@SelectedJob.ResponseMessage</small>
                        }
                    </section>
                    <div class="profile-actions">
                        <button class="primary-action collection-close-action" type="button" @onclick="CloseJobDetail">Close</button>
                    </div>
                </div>
            </section>
        </div>
    }

    @if (IsSummaryDialogOpen)
    {
        <div class="summary-list-overlay" role="presentation">
            <section class="summary-list-dialog collection-summary-dialog collection-plant-list-dialog" role="dialog" aria-modal="true" aria-labelledby="collection-summary-title">
                <div class="summary-list-header collection-summary-header">
                    <div>
                        <p class="section-label">Plant API collection jobs</p>
                        <h2 id="collection-summary-title">@SummaryDialogTitle</h2>
                    </div>
                    <button class="profile-close" type="button" @onclick="CloseSummaryDialog" aria-label="Close plant list">&#215;</button>
                </div>
                <div class="summary-list-body">
                    <p class="summary-list-count">@SummaryJobs.Select(job => job.PlantName).Distinct().Count() plant(s) · @SummaryJobs.Count collection job(s)</p>
                    @foreach (var job in TablePaging.Slice(SummaryJobs, CollectionSummaryPage))
                    {
                        <article class="summary-list-item">
                            <span class="summary-plant-code">@GetPlantCode(job.PlantName)</span>
                            <div class="summary-item-copy">
                                <strong>@job.PlantName</strong>
                                <p>@job.Description</p>
                                <small>@DisplayCollectionId(job.CollectionId) · @job.ApiType / @job.DataType · @TimeDisplay.DateTimeWithSeconds(job.RunAt)</small>
                            </div>
                            <span class="status-pill status-@job.Status.ToLowerInvariant()">@job.Status</span>
                        </article>
                    }
                </div>
                <TablePagination TotalItems="@SummaryJobs.Count" @bind-Page="CollectionSummaryPage" />
                <div class="summary-list-footer">
                    <button class="profile-cancel" type="button" @onclick="CloseSummaryDialog">Close</button>
                </div>
            </section>
        </div>
    }

    @if (IsRunDialogOpen)
    {
        <div class="collection-overlay" role="presentation">
            <section class="collection-dialog manual-batch-dialog" role="dialog" aria-modal="true" aria-labelledby="manual-run-title">
                <div class="collection-dialog-header">
                    <div><p class="section-label">All active API endpoints</p><h2 id="manual-run-title">Run manual collection</h2></div>
                    <button class="profile-close" type="button" disabled="@IsRunningManualCollection" @onclick="CloseRunDialog" aria-label="Close manual collection">&#215;</button>
                </div>

                <div class="collection-dialog-body">
                    <p class="collection-dialog-intro">Select one data type, then run it for every active LSS plant. Each LSS status changes automatically when its collection finishes.</p>
                    @if (!string.IsNullOrWhiteSpace(ManualCollectionError))
                    {
                        <div class="admin-alert error">@ManualCollectionError</div>
                    }
                    <label class="filter-field manual-batch-data-select">
                        <span>Data type</span>
                        <select @bind="SelectedManualBatchKey" @bind:after="ManualBatchDataTypeChangedAsync" disabled="@IsRunningManualCollection">
                            @foreach (var option in ManualBatchOptions)
                            {
                                <option value="@option.Key">@option.Label</option>
                            }
                        </select>
                        <small>All active LSS plants are included automatically.</small>
                    </label>
                    <section class="manual-batch-summary" aria-label="Manual collection progress">
                        <div><small>Total LSS</small><strong>@ManualBatchItems.Count</strong></div>
                        <div class="batch-success-count"><small>Successful</small><strong>@ManualBatchItems.Count(item => item.Status == "Successful")</strong></div>
                        <div class="batch-failed-count"><small>Failed</small><strong>@ManualBatchItems.Count(item => item.Status == "Failed")</strong></div>
                        <div><small>Remaining</small><strong>@ManualBatchItems.Count(item => item.Status is "Start" or "Processing")</strong></div>
                    </section>

                    <div class="manual-batch-list">
                        @foreach (var item in ManualBatchItems)
                        {
                            <article class="manual-batch-item batch-@item.Status.ToLowerInvariant()">
                                <span class="manual-batch-icon">@GetPlantCode(item.PlantName)</span>
                                <div class="manual-batch-plant"><strong>@item.PlantId</strong><small>@item.PlantName · @item.State</small></div>
                                <span class="api-type-badge api-type-@item.ApiType.ToLowerInvariant()">@item.ApiType</span>
                                <div class="manual-batch-type"><strong>@item.DataType</strong><small>@item.Message</small></div>
                                <span class="manual-batch-status"><i></i>@item.Status</span>
                            </article>
                        }
                        @if (ManualBatchItems.Count == 0)
                        {
                            <div class="collection-empty"><strong>No active API endpoint found</strong><span>Configure and verify plant DDQ/MMF endpoints first.</span></div>
                        }
                    </div>

                    <div class="profile-actions manual-batch-actions">
                        <button class="profile-cancel" type="button" disabled="@IsRunningManualCollection" @onclick="CloseRunDialog">@(ManualBatchHasRun ? "Close & view history" : "Cancel")</button>
                        <button class="primary-action collection-run-action" type="button" disabled="@(IsRunningManualCollection || ManualBatchItems.Count == 0 || ManualBatchHasRun)" @onclick="RunAllManualCollectionsAsync">
                            <span class="collection-run-icon">&#9654;</span> @(IsRunningManualCollection ? $"Running {ManualBatchCompletedCount}/{ManualBatchItems.Count}..." : ManualBatchHasRun ? "Run completed" : "Run all LSS")
                        </button>
                    </div>
                </div>
            </section>
        </div>
    }

    @if (IsReplaceConfirmationOpen && SelectedPlant is not null)
    {
        <div class="schedule-confirm-overlay">
            <section class="schedule-status-confirmation" role="alertdialog" aria-modal="true" aria-labelledby="manual-replace-title">
                <button class="profile-close" type="button" aria-label="Close confirmation" @onclick="CancelReplacement">&#215;</button>
                <span class="schedule-status-warning">!</span>
                <div>
                    <p class="section-label">Existing scheduled collection</p>
                    <h3 id="manual-replace-title">Confirm manual replacement</h3>
                    <p>@ReplaceConfirmationMessage</p>
                    <div>
                        <button type="button" class="profile-cancel" @onclick="CancelReplacement">Keep Existing Data</button>
                        <button type="button" class="primary-action collection-run-action" @onclick="ConfirmReplacementAsync">Confirm &amp; Run Manual</button>
                    </div>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private int CollectionPage { get; set; } = 1;
    private int CollectionSummaryPage { get; set; } = 1;
}
