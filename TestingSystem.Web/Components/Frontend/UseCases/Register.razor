@page "/register"
@attribute [AllowAnonymous]
@layout TestingSystem.Web.Components.Layout.LoginLayout

<PageTitle>Create account | Single Buyer LSS Repository</PageTitle>

<div class="login-page">
    <section class="login-story">
        <div class="brand-lockup brand-lockup-light">
            <img class="brand-logo" src="single-buyer-logo.png" alt="Single Buyer" />
            <span><small>Large Scale Solar Repository</small></span>
        </div>
        <div class="story-copy">
            <p class="section-label section-label-light">Secure energy information</p>
            <h1>REQUEST REPOSITORY ACCESS</h1>
        </div>
        <div class="energy-orbit" aria-hidden="true">
            <span class="orbit-sun"></span><span class="orbit-line orbit-line-one"></span>
            <span class="orbit-line orbit-line-two"></span><span class="orbit-grid"></span>
        </div>
    </section>

    <section class="login-panel">
        <div class="login-card registration-card">
            <div class="login-access-card">
                <p class="section-label">Local account</p>
                <h2>Create account</h2>
                <p class="login-intro">Submit your details. Access remains pending until a Super Admin approves the account.</p>

                @if (!string.IsNullOrWhiteSpace(Error))
                {
                    <div class="login-alert" role="alert">@(Error switch
                    {
                        "exists" => "That username or email is already registered.",
                        "password" => "Use at least 12 characters with uppercase, lowercase, number and symbol.",
                        _ => "Complete all fields and make sure both passwords match."
                    })</div>
                }

                <form method="post" action="/account/register" class="login-form">
                    <AntiforgeryToken />
                    <label for="register-name">Full name</label>
                    <div class="input-shell"><span>NM</span><input id="register-name" name="displayName" autocomplete="name" required /></div>
                    <label for="register-username">Username</label>
                    <div class="input-shell"><span>ID</span><input id="register-username" name="userName" autocomplete="username" required /></div>
                    <label for="register-email">Email</label>
                    <div class="input-shell"><span>EM</span><input id="register-email" name="email" type="email" autocomplete="email" required /></div>
                    <label for="register-password">Password</label>
                    <div class="input-shell"><span>PW</span><input id="register-password" name="password" type="password" autocomplete="new-password" required /></div>
                    <label for="register-confirm">Confirm password</label>
                    <div class="input-shell"><span>PW</span><input id="register-confirm" name="confirmPassword" type="password" autocomplete="new-password" required /></div>
                    <button type="submit" class="login-button"><span>Submit access request</span><span class="login-arrow">→</span></button>
                </form>
                <div class="first-access-note"><span aria-hidden="true">←</span><p>Already registered? <a href="/login">Return to sign in</a>.</p></div>
            </div>
        </div>
        <SystemFooter LoginVariant="true" />
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}
