@page "/admin/report-automation"
@attribute [Authorize(Roles = "SuperAdministrator,Administrator")]
@rendermode InteractiveServer

<PageTitle>Report Automation | SBLSS System</PageTitle>

<div class="admin-page report-automation-page">
    <header class="page-heading">
        <div>
            <p class="section-label">Administration</p>
            <h1>Report Automation</h1>
            <p class="page-subtitle">Manage report schedules, email distribution lists and delivery results.</p>
        </div>
        @if (ActiveTab == "Schedules")
        {
            <button class="primary-action admin-primary" type="button" @onclick="OpenAddSchedule">+ New Schedule</button>
        }
    </header>

    <section class="admin-summary"><div><small>Total schedules</small><strong>@Schedules.Count</strong></div><div><small>Active schedules</small><strong>@Schedules.Count(x => x.IsActive)</strong></div><div><small>Inactive schedules</small><strong>@Schedules.Count(x => !x.IsActive)</strong></div></section>

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="admin-overlay success-overlay"><section class="configuration-success-dialog" role="dialog" aria-modal="true">
            <button class="profile-close" type="button" @onclick="() => SuccessMessage = string.Empty">&#215;</button>
            <span class="configuration-success-icon">&#10003;</span><p class="section-label">Report automation</p>
            <h2>Configuration saved</h2><p>@SuccessMessage</p>
            <button class="primary-action admin-primary success-done" type="button" @onclick="() => SuccessMessage = string.Empty">Done</button>
        </section></div>
    }

    <nav class="report-section-tabs" aria-label="Report automation sections">
        <button class="@(ActiveTab == "Schedules" ? "active" : null)" type="button" @onclick="ShowSchedules">Report schedules <small>@Schedules.Count</small></button>
        <button class="@(ActiveTab == "Delivery" ? "active" : null)" type="button" @onclick="ShowDelivery">Delivery monitor <small>@Deliveries.Count</small></button>
    </nav>

    @if (ActiveTab == "Schedules")
    {
        <section class="admin-toolbar"><label class="admin-search"><span>&#8981;</span><input type="search" placeholder="Search schedule, plant, data or email list..." @bind="SearchTerm" @bind:event="oninput" /></label><span class="result-count">@FilteredSchedules.Count schedule(s)</span></section>
        <div class="api-type-switch" role="group">@foreach (var type in ApiTypes) { <button type="button" class="@(SelectedReportApi == type ? "active" : null)" @onclick="() => SelectedReportApi = type"><span class="api-switch-dot api-switch-@type.ToLowerInvariant()"></span>@type reports<small>@Schedules.Count(x => EffectiveSource(x) == type)</small></button> }</div>
        <section class="table-panel admin-panel report-simple-panel">
            <div class="admin-table-heading"><div><p class="section-label">@SelectedReportApi automation</p><h2>@SelectedReportApi Report Schedules</h2></div><span>Timezone: Asia/Kuala_Lumpur</span></div>
            <div class="report-simple-table">
                <div class="report-simple-row admin-table-header"><span>Schedule</span><span>Plants</span><span>Report data</span><span>Send schedule</span><span>Recipients</span><span>Status</span><span>Action</span></div>
                @foreach (var schedule in FilteredSchedules)
                {
                    <div class="report-simple-row">
                        <div class="admin-entity schedule-identity"><span>RS</span><div><strong>@schedule.Name</strong><small>@schedule.Id</small></div></div>
                        <span><strong>@GetPlantSummary(schedule.Plants)</strong><small>@PlantNames.Count plant(s)</small></span>
                        <span title="@string.Join(", ", EffectiveDataFields(schedule))"><strong>@GetDataSummary(schedule)</strong><small>@EffectiveInterval(schedule) minute data interval</small></span>
                        <span><strong>@EffectiveScheduleType(schedule)</strong><small>@ScheduleDescription(schedule)</small></span>
                        <span title="@string.Join("; ", EffectiveRecipients(schedule))"><strong>@RecipientSummary(schedule)</strong><small>@RecipientCount(schedule) email(s)</small></span>
                        <span class="status-pill @(schedule.IsActive ? "status-successful" : "status-failed")">@(schedule.IsActive ? "Active" : "Inactive")</span>
                        <button class="admin-edit-action" type="button" @onclick="() => OpenEditSchedule(schedule)">Edit</button>
                    </div>
                }
                @if (FilteredSchedules.Count == 0) { <div class="api-registry-empty">No @SelectedReportApi report schedule matches the current search.</div> }
            </div>
        </section>
    }
    else
    {
        <section class="admin-toolbar"><label class="admin-search"><span>&#8981;</span><input type="search" placeholder="Search delivery, API, data type or recipient..." @bind="DeliverySearchTerm" @bind:event="oninput" /></label><span class="result-count">@FilteredDeliveries.Count delivery attempt(s)</span></section>
        <section class="table-panel automation-panel delivery-panel">
            <div class="automation-heading"><div><p class="section-label">Scheduled report delivery</p><h2>Email report delivery monitor</h2></div><span>Latest delivery attempts shown first · Asia/Kuala_Lumpur</span></div>
            <div class="delivery-table">
                <div class="delivery-row delivery-modern-row automation-table-header"><span>Report delivery</span><span>Report data</span><span>Send schedule</span><span>Generated</span><span>Recipients</span><span>Report</span><span>Email</span><span>Overall</span><span>Action</span></div>
                @foreach (var delivery in FilteredDeliveries)
                {
                    <div class="delivery-row delivery-modern-row">
                        <div class="automation-name"><span>@DeliverySource(delivery)</span><div><strong>@delivery.ScheduleName</strong><small>@delivery.Id</small></div></div>
                        <span><strong>@DeliveryDataSummary(delivery)</strong><small>@DeliveryIntervalSummary(delivery)</small></span>
                        <span><strong>@DeliveryScheduleType(delivery)</strong><small>@DeliveryScheduleDescription(delivery)</small></span>
                        <time>@delivery.GeneratedAt.ToString("dd MMM yyyy")<small>@delivery.GeneratedAt.ToString("HH:mm:ss")</small></time>
                        <span title="@string.Join("; ", delivery.Recipients)"><strong>@DeliveryRecipientSummary(delivery)</strong><small>@delivery.Recipients.Count email(s)</small></span>
                        <span class="delivery-state state-@GetCssValue(delivery.MainReportStatus)">@delivery.MainReportStatus</span>
                        <span class="delivery-state state-@GetCssValue(delivery.MainEmailStatus)">@delivery.MainEmailStatus</span>
                        <span class="status-pill delivery-overall-@delivery.OverallStatus.ToLowerInvariant()">@delivery.OverallStatus</span>
                        <button class="table-action automation-view" type="button" @onclick="() => ViewDelivery(delivery)">View</button>
                    </div>
                }
                @if (FilteredDeliveries.Count == 0) { <div class="api-registry-empty">No delivery attempt matches the current search.</div> }
            </div>
        </section>
    }

    @if (IsScheduleDialogOpen)
    {
        <div class="admin-overlay"><section class="admin-dialog automation-dialog report-schedule-dialog" role="dialog" aria-modal="true" aria-labelledby="report-schedule-form-title">
            <div class="admin-dialog-header"><div><p class="section-label">Automated email report</p><h2 id="report-schedule-form-title">@(EditingScheduleId is null ? "Create report schedule" : "Update report schedule")</h2></div><button class="profile-close" type="button" @onclick="CloseScheduleDialog">&#215;</button></div>
            <form @onsubmit="SaveSchedule" @onsubmit:preventDefault>
                @if (!string.IsNullOrWhiteSpace(FormError)) { <div class="admin-alert error">@FormError</div> }
                <div class="admin-form-grid">
                    <label class="wide"><span>Schedule name</span><input required placeholder="Example: Daily DDQ Operations Report" @bind="ScheduleName" /><small>A clear name for identifying this email schedule.</small></label>
                    <label><span>API type</span><select value="@SelectedApiType" @onchange="OnApiTypeChanged">@foreach (var type in ApiTypes) { <option value="@type">@type</option> }</select><small>Choose the analytics source for this report.</small></label>
                    @if (SelectedApiType == "DDQ") { <label><span>Data type</span><select value="@SelectedDataType" @onchange="OnDataTypeChanged">@foreach (var dataType in DdqDataTypes) { <option value="@dataType">@dataType</option> }</select><small>Select one DDQ forecast data type.</small></label> }
                    else { <label><span>Data type</span><input value="All MMF parameters" readonly /><small>Every available MMF parameter will be included automatically.</small></label> }
                    @if (SelectedApiType == "MMF") { <label class="wide"><span>Data interval</span><input value="15 minutes" readonly /><small>MMF measurements are stored and reported every 15 minutes.</small></label> }
                    else { <label class="wide"><span>Data interval</span><select @bind="SelectedInterval">@foreach (var interval in Intervals) { <option value="@interval.Value">@interval.Label</option> }</select><small>Set the reading interval used for the selected DDQ data type.</small></label> }
                </div>
                <div class="report-all-plants-note"><span>&#10003;</span><div><strong>All active LSS plants included</strong><small>The report automatically includes all @PlantNames.Count active plants configured in the system.</small></div></div>
                <div class="admin-form-grid report-delivery-grid">
                    <label class="wide"><span>Schedule type</span><select value="@SelectedScheduleType" @onchange="OnScheduleTypeChanged">@foreach (var type in ReportScheduleTypes) { <option value="@type">@type</option> }</select><small>Select when the system should generate and email this report.</small></label>
                    @if (SelectedScheduleType == "Rolling 24 Hour") { <label class="wide"><span>Report frequency</span><input value="Every @SelectedInterval minutes" readonly /><small>The report is generated repeatedly throughout the day using the selected data interval.</small></label> }
                    else if (SelectedScheduleType == "Weekly") { <label><span>Day of week</span><select @bind="SelectedScheduleDay">@foreach (var day in WeekDays) { <option value="@day">@day</option> }</select><small>Select the weekly report day.</small></label><label><span>Schedule time</span><input type="time" required step="60" value="@ExecutionTime" @onchange="OnExecutionTimeChanged" /><small>Malaysia time (24-hour format).</small></label> }
                    else if (SelectedScheduleType == "4 Month") { <label><span>Day of month</span><input type="number" min="1" max="28" placeholder="1–28" @bind="SelectedScheduleDay" /><small>Choose day 1–28 to support every month.</small></label><label><span>Schedule time</span><input type="time" required step="60" value="@ExecutionTime" @onchange="OnExecutionTimeChanged" /><small>Malaysia time (24-hour format).</small></label><div class="wide schedule-month-field"><span class="schedule-field-label">Send in selected months</span><div class="schedule-month-options">@foreach (var month in Months) { <button type="button" class="@(SelectedScheduleMonths.Contains(month.Value) ? "selected" : null)" aria-pressed="@SelectedScheduleMonths.Contains(month.Value)" @onclick="() => ToggleScheduleMonth(month.Value)">@month.Label</button> }</div><small>Select one or more months when this report should be generated and emailed.</small></div> }
                    else { <label class="wide"><span>Schedule time</span><input type="time" required step="60" value="@ExecutionTime" @onchange="OnExecutionTimeChanged" /><small>The report is generated every day at this Malaysia time.</small></label> }
                    <div class="wide report-recipient-field"><span class="schedule-field-label">Recipient email addresses</span>
                        <div class="report-recipient-picker" @onclick="() => IsRecipientDropdownOpen = true">
                            @foreach (var email in SelectedRecipientEmails) { var contact = RecipientContacts.FirstOrDefault(x => x.Email.Equals(email, StringComparison.OrdinalIgnoreCase)); <span class="recipient-chip"><i>@(string.IsNullOrWhiteSpace(contact?.Name) ? "@" : contact.Name[..1].ToUpperInvariant())</i><span><strong>@(contact?.Name ?? email)</strong>@if (contact is not null) { <small>@email</small> }</span><button type="button" aria-label="Remove @email" @onclick:stopPropagation @onclick="() => RemoveRecipient(email)">&#215;</button></span> }
                            <input type="search" autocomplete="off" placeholder="Search name or email" @bind="RecipientSearchTerm" @bind:event="oninput" @onfocus="() => IsRecipientDropdownOpen = true" @onkeydown="OnRecipientKeyDown" />
                            @if (!string.IsNullOrWhiteSpace(RecipientSearchTerm)) { <button class="recipient-add-button" type="button" @onclick:stopPropagation @onclick="AddTypedRecipient">Add</button> }
                        </div>
                        <small class="recipient-help">Search a system user, or type a complete external email address and press Add.</small>
                        @if (IsRecipientDropdownOpen) { <div class="report-recipient-suggestions">@foreach (var contact in RecipientSuggestions) { <button type="button" @onclick="() => AddRecipient(contact)"><i>@(string.IsNullOrWhiteSpace(contact.Name) ? "@" : contact.Name[..1].ToUpperInvariant())</i><span><strong>@(string.IsNullOrWhiteSpace(contact.Name) ? contact.Email : contact.Name)</strong><small>@contact.Email</small></span></button> }@if (!RecipientSuggestions.Any() && !string.IsNullOrWhiteSpace(RecipientSearchTerm)) { <p>No system contact matches. Press Add to use a valid external email.</p> }</div> }
                    </div>
                    @if (EditingScheduleId is not null) { <div class="wide schedule-status-field"><span class="schedule-field-label">Schedule status</span><div class="schedule-status-options" role="group" aria-label="Report schedule status"><button type="button" class="active-option @(SelectedIsActive ? "selected" : null)" aria-pressed="@SelectedIsActive" @onclick="() => SetScheduleStatus(true)"><span class="status-option-icon">&#10003;</span><span><strong>Active</strong><small>Generate and email reports according to this schedule.</small></span></button><button type="button" class="inactive-option @(!SelectedIsActive ? "selected" : null)" aria-pressed="@(!SelectedIsActive)" @onclick="() => SetScheduleStatus(false)"><span class="status-option-icon">&#8212;</span><span><strong>Inactive</strong><small>Keep the schedule saved without sending reports.</small></span></button></div></div> }
                </div>
                @if (IsStatusConfirmationOpen) { <div class="schedule-confirm-overlay"><section class="schedule-status-confirmation" role="alertdialog" aria-modal="true" aria-labelledby="report-status-confirm-title"><button class="profile-close" type="button" aria-label="Close confirmation" @onclick="() => IsStatusConfirmationOpen = false">&#215;</button><span class="schedule-status-warning">!</span><div><p class="section-label">Report schedule status</p><h3 id="report-status-confirm-title">Confirm status change</h3><p>This report schedule will change from <b>@(OriginalIsActive ? "Active" : "Inactive")</b> to <b>@(SelectedIsActive ? "Active" : "Inactive")</b>. @(SelectedIsActive ? "Scheduled report emails will resume." : "Scheduled report emails will stop until this schedule is activated again.")</p><div><button type="button" class="profile-cancel" @onclick="() => IsStatusConfirmationOpen = false">Cancel</button><button type="button" class="confirm-status-action" @onclick="ConfirmStatusChangeAsync">Confirm Status Change</button></div></div></section></div> }
                @if (IsDeleteConfirmationOpen) { <div class="schedule-confirm-overlay"><section class="schedule-status-confirmation delete-confirmation-dialog" role="alertdialog" aria-modal="true" aria-labelledby="report-delete-title"><button class="profile-close" type="button" aria-label="Close confirmation" @onclick="() => IsDeleteConfirmationOpen = false">&#215;</button><span class="schedule-status-warning">!</span><div><p class="section-label">Delete schedule</p><h3 id="report-delete-title">Delete this report schedule?</h3><p>This schedule will be permanently removed from MS SQL. Scheduled report emails for it will stop.</p><div><button type="button" class="profile-cancel" @onclick="() => IsDeleteConfirmationOpen = false">Keep Schedule</button><button type="button" class="confirm-delete-action" @onclick="DeleteScheduleAsync">Confirm Delete</button></div></div></section></div> }
                <div class="profile-actions plant-form-actions">@if (EditingScheduleId is not null && !IsDeleteConfirmationOpen) { <button class="delete-plant-action" type="button" @onclick="() => IsDeleteConfirmationOpen = true">Delete Schedule</button> }<span></span><button class="profile-cancel" type="button" @onclick="CloseScheduleDialog">Cancel</button><button class="primary-action admin-primary" type="submit" disabled="@(IsStatusConfirmationOpen || IsDeleteConfirmationOpen)">Save Email Schedule</button></div>
            </form>
        </section></div>
    }

    @if (SelectedDelivery is not null)
    {
        <div class="admin-overlay"><section class="admin-dialog delivery-dialog" role="dialog" aria-modal="true" aria-labelledby="delivery-detail-title">
            <div class="admin-dialog-header"><div><p class="section-label">Delivery result</p><h2 id="delivery-detail-title">@SelectedDelivery.Id</h2></div><button class="profile-close" type="button" @onclick="CloseDelivery">&#215;</button></div>
            <div class="delivery-dialog-body">
                <div class="delivery-detail-head"><span>@SelectedDelivery.Source</span><div><strong>@SelectedDelivery.ScheduleName</strong><small>@SelectedDelivery.GeneratedAt.ToString("dd MMM yyyy, HH:mm:ss")</small></div><span class="status-pill delivery-overall-@SelectedDelivery.OverallStatus.ToLowerInvariant()">@SelectedDelivery.OverallStatus</span></div>
                <dl class="delivery-detail-grid"><div><dt>API type</dt><dd>@DeliverySource(SelectedDelivery)</dd></div><div><dt>Report data</dt><dd>@DeliveryDataSummary(SelectedDelivery)</dd></div><div><dt>Data interval</dt><dd>@DeliveryIntervalSummary(SelectedDelivery)</dd></div><div><dt>Send schedule</dt><dd>@DeliveryScheduleType(SelectedDelivery) · @DeliveryScheduleDescription(SelectedDelivery)</dd></div><div><dt>Email recipients</dt><dd>@SelectedDelivery.Recipients.Count address(es)</dd></div><div class="wide"><dt>Recipient addresses</dt><dd>@string.Join("; ", SelectedDelivery.Recipients)</dd></div></dl>
                <div class="delivery-file-list"><article><span>RPT</span><div><strong>Email report</strong><small>Generation: @SelectedDelivery.MainReportStatus · Email delivery: @SelectedDelivery.MainEmailStatus</small></div></article></div>
                <section class="delivery-message"><strong>Delivery message</strong><p>@SelectedDelivery.Message</p></section>
                <div class="profile-actions"><button class="profile-cancel" type="button" @onclick="CloseDelivery">Close</button></div>
            </div>
        </section></div>
    }
</div>
