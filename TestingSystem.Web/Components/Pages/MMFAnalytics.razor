@page "/mmf-analytics"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@using TestingSystem.Web.Services

<PageTitle>MMF Analytics | SBLSS System</PageTitle>

<div class="mmf-page">
    <header class="page-heading">
        <div>
            <p class="section-label">Market monitoring</p>
            <h1>MMF Analytics</h1>
            <p class="page-subtitle">Analyse forecast and actual plant output through a focused MMF workspace.</p>
        </div>
        <span class="mmf-badge"><span></span> Live MMF workspace</span>
    </header>

    <section class="filter-panel mmf-filter-panel" aria-labelledby="mmf-filter-heading">
        <div class="filter-panel-heading">
            <div>
                <p class="section-label">Step 1 · Query controls</p>
                <h2 id="mmf-filter-heading">MMF Filter</h2>
            </div>
            <button class="filter-reset" type="button" @onclick="ResetFilters">Reset</button>
        </div>

        <form @onsubmit="ApplyFilters" @onsubmit:preventDefault>
            <PlantFilter @key="FilterVersion" Plants="RegisteredPlants" @bind-SelectedIds="SelectedPlantIds" />
            <div class="mmf-filter-grid">

                <label class="filter-field">
                    <span>State</span>
                    <select @bind="SelectedState">
                        <option value="">All states</option>
                        @foreach (var state in States)
                        {
                            <option value="@state">@state</option>
                        }
                    </select>
                </label>

                <label class="filter-field">
                    <span>Parameter</span>
                    <select @bind="SelectedParameter">
                        @foreach (var parameter in Parameters)
                        {
                            <option value="@parameter">@parameter</option>
                        }
                    </select>
                </label>

                <label class="filter-field">
                    <span>Start date</span>
                    <input type="date" @bind="StartDate" @bind:format="yyyy-MM-dd" />
                </label>

                <label class="filter-field">
                    <span>End date</span>
                    <input type="date" @bind="EndDate" @bind:format="yyyy-MM-dd" />
                </label>

                <label class="filter-field">
                    <span>Data interval</span>
                    <select @bind="SelectedInterval">
                        @foreach (var interval in Intervals)
                        {
                            <option value="@interval.Value">@interval.Label</option>
                        }
                    </select>
                </label>
            </div>

            @if (!string.IsNullOrEmpty(ValidationMessage))
            {
                <p class="filter-error" role="alert">@ValidationMessage</p>
            }

            <div class="filter-actions">
                <span>Apply the filter to find available MMF datasets.</span>
                <button class="primary-action mmf-primary-action" type="submit">Apply Filter <span>→</span></button>
            </div>
        </form>
    </section>

    @if (HasApplied)
    {
        <section class="filter-summary mmf-summary" aria-live="polite">
            <span class="summary-mark">MMF</span>
            <div>
                <strong>Filtered MMF description</strong>
                <p>@ResultDescription</p>
            </div>
        </section>

        <section class="dataset-panel mmf-dataset-panel" aria-labelledby="mmf-dataset-heading">
            <div class="dataset-heading">
                <div>
                    <p class="section-label">Step 2</p>
                    <h2 id="mmf-dataset-heading">Select an MMF dataset</h2>
                    <p>Choose one stream to display its interval data table.</p>
                </div>
                <span class="result-count">@Datasets.Count result(s)</span>
            </div>

            <div class="dataset-list">
                @if (Datasets.Count == 0)
                {
                    <p class="analytics-empty" role="status">No plants match these filters. Change your selection or choose All states.</p>
                }
                @foreach (var dataset in Datasets)
                {
                    <button class="dataset-item @(SelectedDataset?.Id == dataset.Id ? "selected" : null)"
                            type="button"
                            @onclick="() => SelectDataset(dataset)">
                        <span class="dataset-code">@dataset.Code</span>
                        <span class="dataset-name">
                            <strong>@dataset.Name</strong>
                            <small>@dataset.PlantName · @dataset.State · @AppliedParameter · Demo data</small>
                        </span>
                        <span class="dataset-meta">
                            <strong>@dataset.CapacityMw.ToString("N0") MW</strong>
                            <small>@dataset.AvailableRows interval(s)</small>
                        </span>
                        <span class="dataset-open">View table <b>→</b></span>
                    </button>
                }
            </div>
        </section>
    }

    @if (SelectedDataset is not null)
    {
        @if (ViewMode == "Table")
        {
            <section class="table-panel mmf-table-panel">
                <div class="ddq-table-heading">
                    <div>
                        <p class="section-label">Step 3 · MMF time-series</p>
                        <h2>@SelectedDataset.Name</h2>
                        <p>@SelectedDataset.Code · @SelectedDataset.CapacityMw.ToString("N0") MW registered capacity</p>
                    </div>
                    <div class="view-actions">
                        <span class="result-count">@Rows.Count row(s)</span>
                        <button class="graph-action" type="button" @onclick="OpenGraphSettings">
                            Convert to Graph <span>↗</span>
                        </button>
                    </div>
                </div>

                <div class="mmf-table" role="table" aria-label="Filtered MMF plant data">
                    <div class="mmf-table-row mmf-table-header" role="row">
                        <span>Timestamp</span>
                        <span>Plant</span>
                        <span>State</span>
                        <span>Parameter</span>
                        <span>Interval</span>
                        <span>Forecast MW</span>
                        <span>Actual MW</span>
                        <span>Variance</span>
                        <span>Status</span>
                    </div>
                    @foreach (var row in Rows)
                    {
                        <div class="mmf-table-row" role="row">
                            <time datetime="@row.Timestamp.ToString("O")">@row.Timestamp.ToString("dd MMM yyyy, HH:mm")</time>
                            <strong>@row.Plant</strong>
                            <span>@row.State</span>
                            <span>@row.Parameter</span>
                            <span>@row.Interval</span>
                            <span>@row.ForecastMw.ToString("N2") MW</span>
                            <strong>@row.ActualMw.ToString("N2") MW</strong>
                            <span class="variance-value @(Math.Abs(row.VariancePercent) > 5 ? "outside" : null)">
                                @row.VariancePercent.ToString("+0.00;-0.00;0.00")%
                            </span>
                            <span><span class="status-pill status-@row.Status.ToLowerInvariant()">@row.Status</span></span>
                        </div>
                    }
                </div>
            </section>
        }
        else
        {
            <section class="graph-panel mmf-graph-panel">
                <div class="graph-heading">
                    <div>
                        <p class="section-label">Step 3 · MMF graph view</p>
                        <h2>Filtered plant comparison</h2>
                        <p>@AppliedYAxis plotted against @AppliedXAxis · @ComparisonSeries.Count plant(s) · Same stream as @SelectedDataset.Name · Demo data</p>
                    </div>
                    <div class="view-actions">
                        <button class="secondary-action" type="button" @onclick="OpenGraphSettings">Graph Settings</button>
                        <button class="graph-action" type="button" @onclick="ShowTable">Back to Table <span>↩</span></button>
                    </div>
                </div>

                <div class="graph-summary-grid">
                    <div><small>Maximum</small><strong>@GraphMaximum.ToString("N2") @GraphUnit</strong></div>
                    <div><small>Average</small><strong>@GraphAverage.ToString("N2") @GraphUnit</strong></div>
                    <div><small>Data points across plants</small><strong>@GraphValues.Count</strong></div>
                </div>

                <div class="ddq-chart-wrap">
                    <div class="y-axis-title">@AppliedYAxis (@GraphUnit)</div>
                    <svg class="ddq-chart mmf-chart" viewBox="0 0 1000 390" role="img" aria-label="@AppliedYAxis against @AppliedXAxis graph">
                        <defs>
                            <linearGradient id="mmfAreaFill" x1="0" x2="0" y1="0" y2="1">
                                <stop offset="0%" stop-color="#049f64" stop-opacity="0.34" />
                                <stop offset="100%" stop-color="#049f64" stop-opacity="0.02" />
                            </linearGradient>
                        </defs>
                        @foreach (var gridY in new[] { 45, 115, 185, 255, 325 })
                        {
                            <line class="chart-grid-line" x1="72" y1="@gridY" x2="970" y2="@gridY" />
                        }
                        <line class="chart-axis-line" x1="72" y1="25" x2="72" y2="325" />
                        <line class="chart-axis-line" x1="72" y1="325" x2="970" y2="325" />
                        @for (var i = 0; i < ComparisonSeries.Count; i++)
                        {
                            var series = ComparisonSeries[i];
                            <polyline fill="none" stroke="@PlantGraphSeries.Colour(i)" stroke-width="3" stroke-dasharray="@(i < 6 ? "none" : "7 4")" points="@PlantGraphSeries.Points(series.Values, GraphMinimum, Math.Max(GraphMaximum, 1))">
                                <title>@series.Name</title>
                            </polyline>
                        }
                        <text class="chart-label" x="72" y="350">@GraphStartLabel</text>
                        <text class="chart-label chart-label-end" x="970" y="350">@GraphEndLabel</text>
                        <text class="chart-label" x="60" y="49" text-anchor="end">@GraphMaximum.ToString("N0")</text>
                        <text class="chart-label" x="60" y="329" text-anchor="end">@GraphMinimum.ToString("N1")</text>
                    </svg>
                    <div class="x-axis-title">@AppliedXAxis</div>
                    <div class="plant-graph-legend" aria-label="Plants in graph">
                        @for (var i = 0; i < ComparisonSeries.Count; i++)
                        {
                            <span><i style="background:@PlantGraphSeries.Colour(i)"></i>@ComparisonSeries[i].Name</span>
                        }
                    </div>
                    <p class="analytics-empty">Based on the last applied filters. Showing up to 200 intervals per plant.</p>
                </div>
            </section>
        }
    }

    @if (IsGraphSettingsOpen)
    {
        <div class="graph-modal-overlay mmf-graph-modal" role="presentation">
            <section class="graph-dialog" role="dialog" aria-modal="true" aria-labelledby="mmf-graph-title">
                <div class="graph-dialog-header">
                    <div>
                        <p class="section-label">MMF graph configuration</p>
                        <h2 id="mmf-graph-title">Choose graph axes</h2>
                    </div>
                    <button class="profile-close" type="button" @onclick="CloseGraphSettings" aria-label="Close graph settings">×</button>
                </div>
                <div class="graph-dialog-body">
                    <p>Compare all plants in the filtered results using the same stream as the open table. Choose the horizontal and vertical axes.</p>
                    <div class="axis-preview">
                        <span><b>Y</b> @PendingYAxis</span>
                        <i>versus</i>
                        <span><b>X</b> @PendingXAxis</span>
                    </div>
                    <div class="graph-form-grid">
                        <label class="filter-field">
                            <span>X-axis (horizontal)</span>
                            <select @bind="PendingXAxis">
                                @foreach (var option in XAxisOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </label>
                        <label class="filter-field">
                            <span>Y-axis (vertical)</span>
                            <select @bind="PendingYAxis">
                                @foreach (var option in YAxisOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </label>
                    </div>
                    <div class="profile-actions">
                        <button class="profile-cancel" type="button" @onclick="CloseGraphSettings">Cancel</button>
                        <button class="primary-action mmf-primary-action" type="button" @onclick="GenerateGraph">
                            Generate Graph <span>→</span>
                        </button>
                    </div>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private List<LssPlant> RegisteredPlants { get; set; } = [];
    private HashSet<int> SelectedPlantIds = [];
    private int FilterVersion;
    private string AppliedParameter = "Irradiance";
    private DateTime AppliedStart;
    private int AppliedInterval;
    private List<string> States { get; set; } = [];
    private static readonly string[] Parameters = ["Irradiance", "GHI", "POA"];
    private static readonly (string Label, int Value)[] Intervals =
    [
        ("15 minutes", 15),
        ("30 minutes", 30),
        ("1 hour", 60)
    ];
    private static readonly string[] XAxisOptions = ["Timestamp", "Data Point Number"];
    private static readonly string[] YAxisOptions = ["Actual MW", "Forecast MW", "Variance"];

    private string SelectedState { get; set; } = string.Empty;
    private string SelectedParameter { get; set; } = "Irradiance";
    private DateTime StartDate { get; set; } = DateTime.Today.AddDays(-1);
    private DateTime EndDate { get; set; } = DateTime.Today;
    private int SelectedInterval { get; set; } = 15;
    private string ValidationMessage { get; set; } = string.Empty;
    private string ResultDescription { get; set; } = string.Empty;
    private bool HasApplied { get; set; }
    private List<MmfDataset> Datasets { get; set; } = [];
    private MmfDataset? SelectedDataset { get; set; }
    private List<MmfRow> Rows { get; set; } = [];
    private List<PlantGraphSeries> ComparisonSeries = [];
    private string ViewMode { get; set; } = "Table";
    private bool IsGraphSettingsOpen { get; set; }
    private string PendingXAxis { get; set; } = "Timestamp";
    private string PendingYAxis { get; set; } = "Actual MW";
    private string AppliedXAxis { get; set; } = "Timestamp";
    private string AppliedYAxis { get; set; } = "Actual MW";

    protected override async Task OnInitializedAsync()
    {
        await using var database = await ContextFactory.CreateDbContextAsync();
        RegisteredPlants = await database.LssPlants
            .Where(plant => plant.IsActive)
            .OrderBy(plant => plant.Name)
            .ToListAsync();
        States = RegisteredPlants.Select(plant => plant.State).Distinct().OrderBy(state => state).ToList();
    }

    private void ApplyFilters()
    {
        ValidationMessage = string.Empty;
        HasApplied = false;
        Datasets = [];
        SelectedDataset = null;
        Rows = [];
        ViewMode = "Table";

        if (EndDate.Date < StartDate.Date)
        {
            ValidationMessage = "The end date must be on or after the start date.";
            return;
        }

        var totalRows = CalculateAvailableRows();
        HasApplied = true;
        IsGraphSettingsOpen = false;
        AppliedParameter = SelectedParameter;
        AppliedStart = StartDate.Date;
        AppliedInterval = SelectedInterval;
        var selectedPlants = AnalyticsPlantFilter.Match(RegisteredPlants, SelectedPlantIds, SelectedState).ToList();
        var streamNames = new[] { $"{SelectedParameter} Forecast", "Operational Availability", "Dispatch Performance" };

        Datasets = selectedPlants.SelectMany(plant => streamNames.Select((name, index) => new MmfDataset(
            plant.Id * 3 + index,
            $"MMF-{plant.PlantId}-{StartDate:yyyyMMdd}-{index + 1:00}",
            $"{plant.Name} {name}", (double)plant.CapacityMw,
            totalRows, plant.Name, plant.State))).ToList();

        var limitNote = totalRows > 200 ? $" Each table displays the first 200 of {totalRows} intervals." : string.Empty;
        ResultDescription = $"Demo data: {Datasets.Count} {SelectedParameter} MMF dataset(s) for {string.Join(", ", selectedPlants.Select(p => p.Name))}, "
            + $"from {StartDate:dd MMM yyyy} to {EndDate:dd MMM yyyy} at {IntervalLabel} intervals.{limitNote}";
    }

    private void SelectDataset(MmfDataset dataset)
    {
        SelectedDataset = dataset;
        ViewMode = "Table";
        IsGraphSettingsOpen = false;
        Rows = BuildRows(dataset);
    }

    private List<MmfRow> BuildRows(MmfDataset dataset)
    {
        var rowCount = Math.Min(dataset.AvailableRows, 200);
        var startTimestamp = AppliedStart;
        var parameterFactor = AppliedParameter switch
        {
            "GHI" => 0.92,
            "POA" => 1.08,
            _ => 1d
        };

        return Enumerable.Range(0, rowCount)
            .Select(index =>
            {
                var timestamp = startTimestamp.AddMinutes(index * AppliedInterval);
                var solarCurve = Math.Max(0, Math.Sin((timestamp.TimeOfDay.TotalHours - 6) / 13 * Math.PI));
                var forecast = Math.Min(dataset.CapacityMw, solarCurve * dataset.CapacityMw * 0.9 * parameterFactor);
                var variation = Math.Sin((index + dataset.Id) * 0.57) * 4.8;
                var actual = Math.Clamp(forecast * (1 + variation / 100), 0, dataset.CapacityMw);
                var variance = forecast <= 0 ? 0 : (actual - forecast) / forecast * 100;
                var status = Math.Abs(variance) <= 5 ? "Within" : "Alert";

                return new MmfRow(timestamp, dataset.PlantName, dataset.State, AppliedParameter, Intervals.First(i => i.Value == AppliedInterval).Label,
                    Math.Round(forecast, 2), Math.Round(actual, 2), Math.Round(variance, 2), status);
            })
            .ToList();
    }

    private void OpenGraphSettings()
    {
        PendingXAxis = AppliedXAxis;
        PendingYAxis = AppliedYAxis;
        IsGraphSettingsOpen = true;
    }

    private void CloseGraphSettings() => IsGraphSettingsOpen = false;

    private void GenerateGraph()
    {
        AppliedXAxis = PendingXAxis;
        AppliedYAxis = PendingYAxis;
        ComparisonSeries = Datasets.Where(d => SelectedDataset is not null && d.Id % 3 == SelectedDataset.Id % 3)
            .Select(dataset => new PlantGraphSeries(dataset.PlantName,
                BuildRows(dataset).Select(row => AppliedYAxis switch
                {
                    "Forecast MW" => row.ForecastMw,
                    "Variance" => row.VariancePercent,
                    _ => row.ActualMw
                }).ToList())).ToList();
        IsGraphSettingsOpen = false;
        ViewMode = "Graph";
    }

    private void ShowTable() => ViewMode = "Table";

    private void ResetFilters()
    {
        SelectedPlantIds = [];
        FilterVersion++;
        SelectedState = "";
        SelectedParameter = "Irradiance";
        StartDate = DateTime.Today.AddDays(-1);
        EndDate = DateTime.Today;
        SelectedInterval = 15;
        ValidationMessage = string.Empty;
        ResultDescription = string.Empty;
        HasApplied = false;
        Datasets = [];
        SelectedDataset = null;
        Rows = [];
        ViewMode = "Table";
        IsGraphSettingsOpen = false;
        PendingXAxis = AppliedXAxis = "Timestamp";
        PendingYAxis = AppliedYAxis = "Actual MW";
    }

    private int CalculateAvailableRows() =>
        (int)Math.Ceiling((EndDate.Date.AddDays(1) - StartDate.Date).TotalMinutes / SelectedInterval);

    private string IntervalLabel => Intervals.First(interval => interval.Value == SelectedInterval).Label;
    private string GraphUnit => AppliedYAxis == "Variance" ? "%" : "MW";
    private List<double> GraphValues => ComparisonSeries.SelectMany(s => s.Values).ToList();
    private double GraphMinimum => GraphValues.Count == 0 ? 0 : Math.Min(0, GraphValues.Min());
    private double GraphMaximum => GraphValues.Count == 0 ? 0 : GraphValues.Max();
    private double GraphAverage => GraphValues.Count == 0 ? 0 : GraphValues.Average();
    private string GraphLinePoints => BuildGraphPoints();
    private string GraphAreaPoints => Rows.Count == 0 ? string.Empty : $"72,325 {GraphLinePoints} 970,325";
    private string GraphStartLabel => AppliedXAxis == "Timestamp" && Rows.Count > 0
        ? Rows[0].Timestamp.ToString("dd MMM HH:mm")
        : "Point 1";
    private string GraphEndLabel => AppliedXAxis == "Timestamp" && Rows.Count > 0
        ? Rows[^1].Timestamp.ToString("dd MMM HH:mm")
        : $"Point {Rows.Count}";

    private string BuildGraphPoints()
    {
        if (Rows.Count == 0)
        {
            return string.Empty;
        }

        var values = GraphValues;
        var maximum = Math.Max(values.Max(), 1);
        return string.Join(" ", values.Select((value, index) =>
        {
            var x = Rows.Count == 1 ? 72 : 72 + (898d * index / (Rows.Count - 1));
            var y = 325 - (280d * value / maximum);
            return FormattableString.Invariant($"{x:F1},{y:F1}");
        }));
    }

    private sealed record MmfDataset(int Id, string Code, string Name, double CapacityMw, int AvailableRows, string PlantName, string State);

    private sealed record MmfRow(
        DateTime Timestamp,
        string Plant,
        string State,
        string Parameter,
        string Interval,
        double ForecastMw,
        double ActualMw,
        double VariancePercent,
        string Status);
}
