@page "/repository"
@page "/collection-management"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Collection Management | Single Buyer LSS</PageTitle>

<div class="collection-page">
    <header class="page-heading">
        <div>
            <p class="section-label">DDQ data operations</p>
            <h1>Collection Management</h1>
            <p class="page-subtitle">Monitor automated collections and run DDQ plant collection manually.</p>
        </div>
        <button class="primary-action collection-run-action" type="button" @onclick="OpenRunDialog">
            <span class="collection-run-icon">&#9654;</span> Run Manual
        </button>
    </header>

    <section class="collection-summary" aria-label="Collection summary">
        <button type="button" class="summary-stat" @onclick="OpenAllSummary">
            <small>Total jobs</small><strong>@Jobs.Count</strong><span>View plants</span>
        </button>
        <button type="button" class="summary-stat" @onclick="OpenSuccessfulSummary">
            <small>Successful</small><strong>@Jobs.Count(job => job.Status == "Successful")</strong><span>View plants</span>
        </button>
        <button type="button" class="summary-stat" @onclick="OpenFailedSummary">
            <small>Failed</small><strong>@Jobs.Count(job => job.Status == "Failed")</strong><span>View plants</span>
        </button>
        <p><span class="live-dot"></span> DDQ collection monitoring is active</p>
    </section>

    <section class="collection-toolbar">
        <label class="collection-search">
            <span aria-hidden="true">&#8981;</span>
            <input type="search" placeholder="Search plant, collection ID, mode or status..."
                   @bind="SearchTerm" @bind:event="oninput" />
        </label>
        <span class="result-count">@FilteredJobs.Count record(s)</span>
    </section>

    <section class="table-panel collection-panel">
        <div class="collection-table-heading">
            <div>
                <p class="section-label">DDQ collection jobs</p>
                <h2>Collection history</h2>
            </div>
            <span>Latest activity shown first</span>
        </div>

        <div class="collection-table" role="table" aria-label="DDQ collection job history">
            <div class="collection-row collection-header" role="row">
                <span>Plant name</span><span>Mode</span><span>Collection</span>
                <span>Submission date</span><span>Run timestamp</span><span>Status</span>
            </div>
            @if (FilteredJobs.Count == 0)
            {
                <div class="collection-empty">
                    <strong>No collection job found</strong>
                    <span>Try a different plant, collection ID, mode or status.</span>
                </div>
            }
            else
            {
                @foreach (var job in FilteredJobs)
                {
                    <div class="collection-row" role="row">
                        <div class="collection-plant">
                            <span>@GetPlantCode(job.PlantName)</span>
                            <div><strong>@job.PlantName</strong><small>@job.State</small></div>
                        </div>
                        <span><span class="collection-mode mode-@job.Mode.ToLowerInvariant()">@job.Mode</span></span>
                        <div class="collection-reference"><strong>@job.CollectionId</strong><small>@job.Description</small></div>
                        <time datetime="@job.SubmissionDate.ToString("O")">@job.SubmissionDate.ToString("dd MMM yyyy")</time>
                        <time datetime="@job.RunAt.ToString("O")">@job.RunAt.ToString("dd MMM yyyy, HH:mm:ss")</time>
                        <span><span class="status-pill status-@job.Status.ToLowerInvariant()">@job.Status</span></span>
                    </div>
                }
            }
        </div>
    </section>

    @if (IsSummaryDialogOpen)
    {
        <div class="summary-list-overlay" role="presentation">
            <section class="summary-list-dialog collection-summary-dialog" role="dialog" aria-modal="true" aria-labelledby="collection-summary-title">
                <div class="summary-list-header">
                    <div>
                        <p class="section-label">DDQ collection plants</p>
                        <h2 id="collection-summary-title">@SummaryDialogTitle</h2>
                    </div>
                    <button class="profile-close" type="button" @onclick="CloseSummaryDialog" aria-label="Close plant list">&#215;</button>
                </div>
                <div class="summary-list-body">
                    <p class="summary-list-count">@SummaryJobs.Count collection job(s)</p>
                    @foreach (var job in SummaryJobs)
                    {
                        <article class="summary-list-item">
                            <span class="summary-plant-code">@GetPlantCode(job.PlantName)</span>
                            <div class="summary-item-copy">
                                <strong>@job.PlantName</strong>
                                <p>@job.Description</p>
                                <small>@job.CollectionId · @job.Mode · @job.RunAt.ToString("dd MMM yyyy, HH:mm:ss")</small>
                            </div>
                            <span class="status-pill status-@job.Status.ToLowerInvariant()">@job.Status</span>
                        </article>
                    }
                </div>
                <div class="summary-list-footer">
                    <button class="profile-cancel" type="button" @onclick="CloseSummaryDialog">Close</button>
                </div>
            </section>
        </div>
    }

    @if (IsRunDialogOpen)
    {
        <div class="collection-overlay" role="presentation">
            <section class="collection-dialog" role="dialog" aria-modal="true" aria-labelledby="manual-run-title">
                <div class="collection-dialog-header">
                    <div><p class="section-label">DDQ manual collection</p><h2 id="manual-run-title">Run plant collection</h2></div>
                    <button class="profile-close" type="button" @onclick="CloseRunDialog" aria-label="Close manual run form">&#215;</button>
                </div>

                <div class="collection-dialog-body">
                    @if (RunResult is null)
                    {
                        <p class="collection-dialog-intro">Select a plant to verify its configured connection before starting the collection.</p>
                        <label class="filter-field collection-plant-select">
                            <span>Plant name</span>
                            <select @bind="SelectedPlantName">
                                @foreach (var plant in Plants)
                                {
                                    <option value="@plant.Name">@plant.Name</option>
                                }
                            </select>
                        </label>

                        <section class="plant-connection-card">
                            <div class="plant-connection-title">
                                <span>@GetPlantCode(SelectedPlant.Name)</span>
                                <div><strong>@SelectedPlant.Name</strong><small>@SelectedPlant.State, Malaysia</small></div>
                                <span class="connection-ready"><i></i> Ready</span>
                            </div>
                            <dl class="plant-information">
                                <div><dt>Plant ID</dt><dd>@SelectedPlant.PlantId</dd></div>
                                <div><dt>Collection type</dt><dd>DDQ interval data</dd></div>
                                <div><dt>Submission date</dt><dd>@DateTime.Today.ToString("dd MMM yyyy")</dd></div>
                                <div><dt>Authentication</dt><dd>API key</dd></div>
                            </dl>
                            <div class="api-endpoint">
                                <div><span>Configured API endpoint</span><small>Managed in Admin Configuration</small></div>
                                <code>@SelectedPlant.ApiUrl</code>
                            </div>
                        </section>

                        <div class="profile-actions">
                            <button class="profile-cancel" type="button" @onclick="CloseRunDialog">Cancel</button>
                            <button class="primary-action collection-run-action" type="button" @onclick="RunCollection">
                                <span class="collection-run-icon">&#9654;</span> Run Collection
                            </button>
                        </div>
                    }
                    else
                    {
                        <section class="collection-result result-@RunResult.Status.ToLowerInvariant()">
                            <span class="collection-result-icon">@(RunResult.Status == "Successful" ? "OK" : "!")</span>
                            <p class="section-label">Collection completed</p>
                            <h3>@RunResult.Status</h3>
                            <p>@RunResult.ResponseMessage</p>
                            <dl>
                                <div><dt>Plant</dt><dd>@RunResult.PlantName</dd></div>
                                <div><dt>Collection ID</dt><dd>@RunResult.CollectionId</dd></div>
                                <div><dt>Completed at</dt><dd>@RunResult.RunAt.ToString("dd MMM yyyy, HH:mm:ss")</dd></div>
                                <div><dt>Duration</dt><dd>@RunResult.DurationSeconds.ToString("0.0") seconds</dd></div>
                            </dl>
                        </section>
                        <div class="profile-actions">
                            <button class="primary-action collection-close-action" type="button" @onclick="CloseRunDialog">Close &amp; view history</button>
                        </div>
                    }
                </div>
            </section>
        </div>
    }
</div>
