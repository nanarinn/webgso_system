@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> ContextFactory

<PageTitle>Overview | Single Buyer LSS Repository</PageTitle>

<header class="page-heading">
    <div>
        <p class="section-label">Repository overview</p>
        <h1>Large Scale Solar portfolio</h1>
        <p class="page-subtitle">A controlled view of project documents, approvals and delivery milestones.</p>
    </div>
    <a class="primary-action" href="collection-management">Open collection <span>→</span></a>
</header>

<section class="metric-grid" aria-label="Operational summary">
    <button class="metric-card metric-card-blue" type="button"
            @onclick="() => OpenMetric(PlantMetricTitle, PlantMetricDescription, PlantItems)">
        <div>
            <strong>@TotalPlants</strong>
            <span>Total plants</span>
        </div>
    </button>
    <button class="metric-card metric-card-green" type="button"
            @onclick="() => OpenMetric(SuccessMetricTitle, SuccessMetricDescription, SuccessfulItems)">
        <div>
            <strong>@DdqSuccessfulRequests</strong>
            <span>DDQ Successful Requests</span>
        </div>
    </button>
    <button class="metric-card metric-card-yellow" type="button"
            @onclick="() => OpenMetric(FailedMetricTitle, FailedMetricDescription, FailedItems)">
        <div>
            <strong>@DdqFailedRequests</strong>
            <span>DDQ Failed Requests</span>
        </div>
    </button>
    <button class="metric-card metric-card-navy" type="button"
            @onclick="() => OpenMetric(MmfMetricTitle, MmfMetricDescription, MmfItems)">
        <div>
            <strong>@ActiveMmf</strong>
            <span>Active MMF</span>
        </div>
    </button>
</section>

<section class="content-grid">
    <article class="panel panel-wide">
        <div class="panel-heading">
            <div>
                <p class="section-label">Recently updated</p>
                <h2>Latest repository records</h2>
            </div>
            <a href="collection-management">View all</a>
        </div>

        <div class="record-list">
            @foreach (var document in RecentDocuments)
            {
                <div class="record-row">
                    <span class="record-code">@document.ReferenceNumber</span>
                    <div class="record-name">
                        <strong>@document.Title</strong>
                        <span>@document.Category</span>
                    </div>
                    <span class="status-pill status-@document.ProjectStage.ToLowerInvariant()">@document.ProjectStage</span>
                    <time datetime="@document.UpdatedAt.ToString("O")">@document.UpdatedAt.ToString("dd MMM yyyy")</time>
                </div>
            }
        </div>
    </article>

    <aside class="panel focus-panel">
        <p class="section-label section-label-light">System status</p>
        <h2>Repository connected</h2>
        <p>Blazor is reading this dashboard directly from Microsoft SQL Server.</p>
        <div class="connection-line">
            <span></span>
            SQL Server online
        </div>
        <a href="health" target="_blank">Open health proof →</a>
    </aside>
</section>

@if (IsMetricOpen)
{
    <div class="metric-modal-overlay" role="presentation">
        <section class="metric-dialog" role="dialog" aria-modal="true" aria-labelledby="metric-dialog-title">
            <div class="metric-dialog-header">
                <div>
                    <p class="section-label">Dashboard details</p>
                    <h2 id="metric-dialog-title">@SelectedMetricTitle</h2>
                    <p>@SelectedMetricDescription</p>
                </div>
                <button class="profile-close" type="button" @onclick="CloseMetric" aria-label="Close list">×</button>
            </div>

            <div class="metric-dialog-summary">
                <span class="summary-mark">@SelectedMetricCode</span>
                <div>
                    <strong>@SelectedMetricItems.Count</strong>
                    <small>Total matching item(s)</small>
                </div>
            </div>

            <div class="metric-detail-list">
                @for (var index = 0; index < SelectedMetricItems.Count; index++)
                {
                    var item = SelectedMetricItems[index];
                    <article class="metric-detail-item">
                        <span class="metric-item-number">@((index + 1).ToString("00"))</span>
                        <div class="metric-item-name">
                            <strong>@item.Name</strong>
                            <small>@item.Description</small>
                        </div>
                        <div class="metric-item-reference">
                            <strong>@item.Reference</strong>
                            <small>@item.UpdatedAt.ToString("dd MMM yyyy")</small>
                        </div>
                        <span class="status-pill status-@item.Status.ToLowerInvariant()">@item.Status</span>
                    </article>
                }
            </div>

            <div class="metric-dialog-footer">
                <span>Data retrieved from the SBLSS repository.</span>
                <button class="primary-action" type="button" @onclick="CloseMetric">Close <span>×</span></button>
            </div>
        </section>
    </div>
}

@code {
    private const string PlantMetricTitle = "Total Plants";
    private const string PlantMetricDescription = "All registered Large Scale Solar plants in the repository.";
    private const string SuccessMetricTitle = "DDQ Successful Requests";
    private const string SuccessMetricDescription = "DDQ submissions that completed validation successfully.";
    private const string FailedMetricTitle = "DDQ Failed Requests";
    private const string FailedMetricDescription = "DDQ submissions that require correction or resubmission.";
    private const string MmfMetricTitle = "Active MMF";
    private const string MmfMetricDescription = "Plants with an active MMF data stream.";

    private int TotalPlants { get; set; }
    private int DdqSuccessfulRequests { get; set; }
    private int DdqFailedRequests { get; set; }
    private int ActiveMmf { get; set; }
    private List<SolarDocument> RecentDocuments { get; set; } = [];
    private List<DashboardItem> PlantItems { get; set; } = [];
    private List<DashboardItem> SuccessfulItems { get; set; } = [];
    private List<DashboardItem> FailedItems { get; set; } = [];
    private List<DashboardItem> MmfItems { get; set; } = [];
    private IReadOnlyList<DashboardItem> SelectedMetricItems { get; set; } = [];
    private string SelectedMetricTitle { get; set; } = string.Empty;
    private string SelectedMetricDescription { get; set; } = string.Empty;
    private string SelectedMetricCode { get; set; } = string.Empty;
    private bool IsMetricOpen { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var database = await ContextFactory.CreateDbContextAsync();
        var documents = await database.SolarDocuments
            .OrderByDescending(document => document.UpdatedAt)
            .ToListAsync();
        var plants = await database.LssPlants
            .Where(plant => plant.IsActive)
            .OrderBy(plant => plant.Name)
            .ToListAsync();

        RecentDocuments = documents.Take(4).ToList();
        PlantItems = plants.Select(plant => new DashboardItem(
            plant.Name,
            $"{plant.State} · {plant.CapacityMw:N0} MW · API configuration registered",
            plant.PlantId,
            plant.IsActive ? "Active" : "Inactive",
            plant.CreatedAt)).ToList();

        SuccessfulItems = documents
            .Where(document => document.ProjectStage == "Active")
            .Select(document => CreateRequestItem(document, "Successful"))
            .ToList();
        FailedItems = documents
            .Where(document => document.ProjectStage == "Review")
            .Select(document => CreateRequestItem(document, "Failed"))
            .ToList();
        MmfItems = plants
            .Where(plant => !string.IsNullOrWhiteSpace(plant.MmfApiEndpoint))
            .Select(plant => new DashboardItem(
                plant.Name,
                $"Active MMF endpoint · {plant.MmfApiEndpoint}",
                plant.PlantId,
                "Active",
                plant.CreatedAt))
            .ToList();

        TotalPlants = PlantItems.Count;
        DdqSuccessfulRequests = SuccessfulItems.Count;
        DdqFailedRequests = FailedItems.Count;
        ActiveMmf = MmfItems.Count;
    }

    private void OpenMetric(string title, string description, IReadOnlyList<DashboardItem> items)
    {
        SelectedMetricTitle = title;
        SelectedMetricDescription = description;
        SelectedMetricItems = items;
        SelectedMetricCode = title switch
        {
            PlantMetricTitle => "PLT",
            SuccessMetricTitle => "OK",
            FailedMetricTitle => "ERR",
            _ => "MMF"
        };
        IsMetricOpen = true;
    }

    private void CloseMetric() => IsMetricOpen = false;

    private static DashboardItem CreateRequestItem(SolarDocument document, string status) =>
        new(
            $"{document.ReferenceNumber} DDQ Submission",
            $"{document.Category} data request for {document.Title}",
            document.ReferenceNumber.Replace("LSS-", "DDQ-"),
            status,
            document.UpdatedAt);

    private sealed record DashboardItem(
        string Name,
        string Description,
        string Reference,
        string Status,
        DateTimeOffset UpdatedAt);
}
