{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "WEBGSO Java (PostgreSQL)",
      "request": "launch",
      "mainClass": "my.webgso.WebgsoApplication",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.local"
    },
    {
      "type": "java",
      "name": "WEBGSO Java (isolated demo)",
      "request": "launch",
      "mainClass": "my.webgso.WebgsoApplication",
      "cwd": "${workspaceFolder}",
      "args": "--spring.profiles.active=demo --server.port=5187"
    }
  ]
}
