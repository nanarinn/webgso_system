{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Single Buyer LSS Repository",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/SBLSS.System.sln"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Start Docker Stack",
      "type": "process",
      "command": "docker",
      "args": ["compose", "up", "--build", "-d"],
      "problemMatcher": []
    },
    {
      "label": "Stop Docker Stack",
      "type": "process",
      "command": "docker",
      "args": ["compose", "down"],
      "problemMatcher": []
    },
    {
      "label": "Inspect SBLSS Database",
      "type": "process",
      "command": "docker",
      "args": [
        "compose",
        "exec",
        "-T",
        "mssql",
        "bash",
        "-lc",
        "/opt/mssql-tools18/bin/sqlcmd -C -S localhost -U sa -P \"$MSSQL_SA_PASSWORD\" -d SingleBuyerLssRepository -i /workspace/database/inspect-database.sql"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Run LSS Repository Locally",
      "type": "process",
      "command": "dotnet",
      "args": ["watch", "--project", "${workspaceFolder}/TestingSystem.Web"],
      "problemMatcher": "$msCompile",
      "isBackground": true
    }
  ]
}
